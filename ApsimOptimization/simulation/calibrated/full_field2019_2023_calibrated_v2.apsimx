                "",
                "[Mustard].LAI as MustardLAI",
                "[Mustard].Phenology.CurrentStageName as MustardStage",
                "[Mustard].AboveGround.Wt as MustardAGWt",
                "[Mustard].AboveGround.N as MustardAGN",
                "[Mustard].Total.Wt as MustardTotalWt",
                "[Mustard].Grain.Total.Wt*10 as MustardYield",
                "[Mustard].Grain.Total.Wt as MustardGrainWt",
                "",
                "[Soil].Swim3.Drainage as Drainage",
                "[Soil].Swim3.Runoff as Runoff",
                "[Soil].Swim3.Pond as PondDepth",
                "[Soil].Swim3.PAW as PAW",
                "sum([Soil].Water.MM) as WaterStored",
                "[Soil].Water.Volumetric as SW",
                "sum([NO3].kgha + [NH4].kgha + [Urea].kgha) as MineralN",
                "[Denitrification].Value + [Denitrification].Natm as Denitrification",
