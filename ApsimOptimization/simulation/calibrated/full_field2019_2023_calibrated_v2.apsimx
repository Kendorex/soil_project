            {
              "$type": "Models.Manager, Models",
              "CodeArray": [
                "using APSIM.Shared.Utilities;",
                "using Models.Core;",
                "using Models.PMF;",
                "using System;",
                "using System.Collections.Generic;",
                "using System.Globalization;",
                "using System.Linq;",
                "",
                "namespace Models",
                "{",
                "    [Serializable]",
                "    public class Script : Model",
                "    {",
                "        [Link] private Clock Clock;",
                "        [Link] private Summary Summary;",
                "        [Link(ByName = true)] private Plant Wheat;",
                "        [Link(ByName = true)] private Plant RedClover;",
                "        [Link(ByName = true)] private Plant PlantainForage;",
                "        [Link(ByName = true)] private Plant Oats;",
                "        [Link(ByName = true)] private Plant Potato;",
                "        [Link(ByName = true)] private Plant Rape;",
                "        [Link(ByName = true)] private Plant Mustard;",
                "",
                "        [Description(\"Crop names in rotation order (e.g. Wheat, Maize, Canola)\")]",
                "        public string[] RotationCrops { get; set; }",
                "        [Description(\"Cultivar for each crop in rotation (same order)\")]",
                "        public string[] RotationCultivars { get; set; }",
                "        [Description(\"Sowing depth for each crop (mm)\")]",
                "        public string[] RotationSowingDepths { get; set; }",
                "        [Description(\"Row spacing for each crop (mm)\")]",
                "        public string[] RotationRowSpacings { get; set; }",
                "        [Description(\"Population for each crop (/m2)\")]",
                "        public string[] RotationPopulations { get; set; }",
                "        [Description(\"Sowing date for each crop (d-mmm; dash for perennial carry-over)\")]",
                "        public string[] RotationSowingDates { get; set; }",
                "        [Description(\"Harvest or cut date for each crop (d-mmm)\")]",
                "        public string[] RotationHarvestDates { get; set; }",
                "",
                "        private Dictionary<string, IPlant> plants;",
                "        private int startYear;",
                "",
                "        [EventSubscribe(\"StartOfSimulation\")]",
                "        private void OnSimulationCommencing(object sender, EventArgs e)",
                "        {",
                "            startYear = Clock.StartDate.Year;",
                "            plants = new Dictionary<string, IPlant>(StringComparer.OrdinalIgnoreCase)",
                "            {",
                "                { \"Wheat\", Wheat }, { \"RedClover\", RedClover },",
                "                { \"PlantainForage\", PlantainForage }, { \"Oats\", Oats },",
                "                { \"Potato\", Potato }, { \"Rape\", Rape }, { \"Mustard\", Mustard }",
                "            };",
                "            ValidateArrays();",
                "",
                "            int index = IndexForYear(Clock.Today.Year);",
                "            if (Clock.Today == Clock.StartDate && index >= 0 && index < RotationCrops.Length &&",
                "                (IsPurePerennial(index) || IsWinterCrop(index)))",
                "                SowGroup(index, \"startup approximation: crop established before available weather record\");",
                "        }",
                "",
                "        [EventSubscribe(\"DoManagement\")]",
                "        private void OnDoManagement(object sender, EventArgs e)",
                "        {",
                "            int index = IndexForYear(Clock.Today.Year);",
                "            if (index < 0 || index >= RotationCrops.Length)",
                "                return;",
                "",
                "            if (!IsWinterCrop(index) && !IsPurePerennial(index) && DateMatches(RotationSowingDates[index]))",
                "            {",
                "                EndPlantsNotIn(index);",
                "                SowGroup(index, \"scheduled sowing\");",
                "            }",
                "",
                "            if (DateMatches(RotationHarvestDates[index]))",
                "                HarvestGroup(index);",
                "",
                "            int next = index + 1;",
                "            if (next < RotationCrops.Length && IsWinterCrop(next) && DateMatches(RotationSowingDates[next]))",
                "            {",
                "                EndPlantsNotIn(next);",
                "                SowGroup(next, \"autumn sowing for next harvest year\");",
                "            }",
                "",
                "            if (Clock.Today.Month == 12 && Clock.Today.Day == 31)",
                "            {",
                "                if (next < RotationCrops.Length)",
                "                    EndPlantsNotIn(next);",
                "                else",
                "                    EndAllPlants();",
                "            }",
                "        }",
                "",
                "        private int IndexForYear(int year) => year - startYear;",
                "",
                "        private void ValidateArrays()",
                "        {",
                "            int n = RotationCrops.Length;",
                "            if (new[] { RotationCultivars.Length, RotationSowingDepths.Length,",
                "                        RotationRowSpacings.Length, RotationPopulations.Length,",
                "                        RotationSowingDates.Length, RotationHarvestDates.Length }.Any(x => x != n))",
                "                throw new Exception(\"All rotation and calendar arrays must have the same length.\");",
                "        }",
                "",
                "        private bool DateMatches(string dayMonth)",
                "        {",
                "            if (string.IsNullOrWhiteSpace(dayMonth) || dayMonth == \"-\")",
                "                return false;",
                "            return DateUtilities.WithinDates(dayMonth, Clock.Today, dayMonth);",
                "        }",
                "",
                "        private string[] Parts(string value, char separator) =>",
                "            value.Split(separator).Select(x => x.Trim()).ToArray();",
                "",
                "        private bool IsPerennial(string crop) =>",
                "            crop.Equals(\"RedClover\", StringComparison.OrdinalIgnoreCase) ||",
                "            crop.Equals(\"PlantainForage\", StringComparison.OrdinalIgnoreCase);",
                "",
                "        private bool IsPurePerennial(int index) => Parts(RotationCrops[index], '+').All(IsPerennial);",
                "",
                "        private bool IsWinterCrop(int index) =>",
                "            RotationCrops[index].IndexOf(\"Wheat\", StringComparison.OrdinalIgnoreCase) >= 0 &&",
                "            RotationCultivars[index].IndexOf(\"Winter_rye\", StringComparison.OrdinalIgnoreCase) >= 0;",
                "",
                "        private void SowGroup(int index, string reason)",
                "        {",
                "            string[] crops = Parts(RotationCrops[index], '+');",
                "            string[] cultivars = Parts(RotationCultivars[index], ';');",
                "            string[] depths = Parts(RotationSowingDepths[index], ';');",
                "            string[] spacings = Parts(RotationRowSpacings[index], ';');",
                "            string[] populations = Parts(RotationPopulations[index], ';');",
                "            for (int i = 0; i < crops.Length; i++)",
                "            {",
                "                IPlant plant = plants[crops[i]];",
                "                if (plant.IsAlive)",
                "                    continue;",
                "                string cultivar = i < cultivars.Length ? cultivars[i] : \"Default\";",
                "                double depth = double.Parse(i < depths.Length ? depths[i] : \"20\", CultureInfo.InvariantCulture);",
                "                double spacing = double.Parse(i < spacings.Length ? spacings[i] : \"150\", CultureInfo.InvariantCulture);",
                "                double population = double.Parse(i < populations.Length ? populations[i] : \"200\", CultureInfo.InvariantCulture);",
                "                plant.Sow(population: population, cultivar: cultivar, depth: depth, rowSpacing: spacing);",
                "                Summary.WriteMessage(this, $\"Sowed {crops[i]} ({cultivar}) on {Clock.Today:d}: {reason}\", MessageType.Information);",
                "            }",
                "        }",
                "",
                "        private void HarvestGroup(int index)",
                "        {",
                "            foreach (string crop in Parts(RotationCrops[index], '+'))",
                "            {",
                "                IPlant plant = plants[crop];",
                "                if (!plant.IsAlive)",
                "                    continue;",
                "                plant.Harvest();",
                "                if (!IsPerennial(crop))",
                "                    plant.EndCrop();",
                "            }",
                "            Summary.WriteMessage(this, $\"Scheduled harvest/cut on {Clock.Today:d}\", MessageType.Information);",
                "        }",
                "",
                "        private void EndPlantsNotIn(int index)",
                "        {",
                "            HashSet<string> keep = new HashSet<string>(Parts(RotationCrops[index], '+'), StringComparer.OrdinalIgnoreCase);",
                "            foreach (KeyValuePair<string, IPlant> item in plants)",
                "                if (item.Value.IsAlive && !keep.Contains(item.Key))",
                "                    item.Value.EndCrop();",
                "        }",
                "",
                "        private void EndAllPlants()",
                "        {",
                "            foreach (IPlant plant in plants.Values)",
                "                if (plant.IsAlive)",
                "                    plant.EndCrop();",
                "        }",
                "    }",
                "}"
              ],
              "Parameters": [
                {
                  "Key": "StartDate",
                  "Value": "1-may"
                },
                {
                  "Key": "EndDate",
                  "Value": "30-may"
                },
                {
                  "Key": "MinESW",
                  "Value": "100"
                },
                {
                  "Key": "MinRain",
                  "Value": "25"
                },
                {
                  "Key": "RainDays",
                  "Value": "12"
                },
                {
                  "Key": "RotationCrops",
                  "Value": "Wheat, Rape, Wheat, Wheat, Oats+RedClover+PlantainForage"
                },
                {
                  "Key": "RotationCultivars",
                  "Value": "Irgina, Rape_sort, Winter_rye_smoke, Zlata, Yakov;First_RedClover;First_Timothy"
                },
                {
                  "Key": "RotationSowingDepths",
                  "Value": "20, 20, 20, 20, 20;10;10"
                },
                {
                  "Key": "RotationRowSpacings",
                  "Value": "150, 200, 150, 150, 150;150;150"
                },
                {
                  "Key": "RotationPopulations",
                  "Value": "200, 45, 200, 200, 250;150;150"
                },
                {
                  "Key": "RotationSowingDates",
                  "Value": "7-May, 10-May, 8-Sep, 12-May, 4-May"
                },
                {
                  "Key": "RotationHarvestDates",
                  "Value": "9-Aug, 31-Aug, 31-Aug, 17-Aug, 31-Aug"
                }
              ],
              "Name": "Sow using a variable rule",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Manager, Models",
              "CodeArray": [
                "using System;",
                "using Models.Core;",
                "namespace Models",
                "{",
                "    [Serializable]",
                "    public class Script : Model",
                "    {",
                "        [Link] Clock Clock;",
                "        [Link] Fertiliser Fertiliser;",
                "",
                "        [Description(\"Type of fertiliser to apply?\")]",
                "        [Display(Type = DisplayType.FertiliserType)] public string FertiliserType { get; set; }",
                "",
                "        [Description(\"Amount of fertiliser to be applied once per sowing date (kg/ha)\")]",
                "        public double Amount { get; set; }",
                "",
                "        private DateTime lastApplication = DateTime.MinValue;",
                "",
                "        [EventSubscribe(\"Sowing\")]",
                "        private void OnSowing(object sender, EventArgs e)",
                "        {",
                "            if (Clock.Today.Date == lastApplication.Date)",
                "                return;",
                "            Fertiliser.Apply(amount: Amount, type: FertiliserType);",
                "            lastApplication = Clock.Today.Date;",
                "        }",
                "    }",
                "}"
              ],
              "Parameters": [
                {
                  "Key": "FertiliserType",
                  "Value": "NO3N"
                },
                {
                  "Key": "Amount",
                  "Value": "30"
                }
              ],
              "Name": "Fertilise at sowing",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Manager, Models",
              "CodeArray": [
                "using APSIM.Shared.Utilities;",
                "using Models.Utilities;",
                "using Models.Soils;",
                "using Models.PMF;",
                "using Models.Core;",
                "using System;",
                "using System.Linq;",
                "",
                "namespace Models",
                "{",
                "    [Serializable] ",
                "    public class Script : Model",
                "    {",
                "        [Description(\"Crop\")]",
                "        public IPlant Crop { get; set; }",
                "        ",
                "        [EventSubscribe(\"DoManagement\")]",
                "        private void OnDoManagement(object sender, EventArgs e)",
                "        {",
                "            if (Crop.IsReadyForHarvesting)",
                "            {",
                "                Crop.Harvest();",
                "                Crop.EndCrop();",
                "            }",
                "        }",
                "    }",
                "}",
                "       "
              ],
              "Parameters": [
                {
                  "Key": "Crop",
                  "Value": "[Wheat]"
                }
              ],
              "Name": "Harvest",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Manager, Models",
              "CodeArray": [
                "using Models.Climate;",
                "using APSIM.Shared.Utilities;",
                "using Models.Soils.Nutrients;",
                "using Models.Soils;",
                "using Models.PMF;",
                "using Models.Core;",
                "using System.Xml.Serialization;",
                "using System;",
                "using System.Linq;",
                "using Models.AgPasture;",
                "using Models.Interfaces;",
                "",
                "namespace Models",
                "{",
                "    [Serializable] ",
                "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                "    public class Script : Model",
                "    {",
                "        [Link] Clock clock;",
                "        [Link] ISummary summary;",
                "        [Link] private Swim3 swim;",
                "        //[Link] private PastureSpecies ryegrass;",
                "        //[Link] private SimpleGrazing grazing;",
                "        ",
                "        public enum LowerBCTypeOptions {gradient,seepage,potential};",
                "",
                "        [Separator(\"Sets the lower boundary condition type (and value if set to 'potential' for SWIM3. The change is applied at the beginning of the first day of the simulation.\")]",
                "        [Description(\"[Get a dropdown] What lower boundary condition is wanted?\")] public LowerBCTypeOptions LowerBCType { get; set; }",
                "        [Description(\"If 'potential', then what potential? (mm) \")] public double LowerBCValue { get; set; }",
                "",
                "        public double SoilWaterStart  { get; set; }",
                "        public double SoilWaterEnd  { get; set; }",
                "",
                "        [EventSubscribe(\"DoDailyInitialisation\")]",
                "        private void DoDailyInitialisation(object sender, EventArgs e)",
                "        {",
                "        }",
                "",
                "        [EventSubscribe(\"DoReportCalculations\")]",
                "        private void DoReportCalculations(object sender, EventArgs e)",
                "        {",
                "        }",
                "",
                "        [EventSubscribe(\"DoManagement\")]",
                "        private void DoDailyCalculations(object sender, EventArgs e)",
                "        {",
                "            if (clock.Today == clock.StartDate)",
                "            {",
                "                summary.WriteMessage(this, \"Script is setting lower boundary condition to \" + LowerBCType, MessageType.Diagnostic);",
                "                if (LowerBCType == LowerBCTypeOptions.gradient)",
                "                    swim.SetLowerBCForGradient(bbcGradient: 0.0);   // in cm/cm (ibbc=0) Note that this is the default setting",
                "                else if (LowerBCType == LowerBCTypeOptions.potential)",
                "                    swim.SetLowerBCForGivenPotential(bbcPotential: LowerBCValue /10.0 );    //  convert to cm (ibbc=1), DUL is -100 cm so values more positive will often result in inflow to the bottom of the soil profile. Input in mm so divide here.",
                "                else if (LowerBCType == LowerBCTypeOptions.seepage)",
                "                    swim.SetLowerBCForSeepage(bbcPotentialSeepage: 0.0);  // in cm (ibbc=3). This is for zero-tension lysimeters",
                "                else",
                "                    throw new Exception(\"Wrong lower boundary condition type\");",
                "            }",
                "        }",
                "    }",
                "}"
              ],
              "Parameters": [
                {
                  "Key": "LowerBCType",
                  "Value": "seepage"
                },
                {
                  "Key": "LowerBCValue",
                  "Value": "-500"
                }
              ],
              "Name": "SWIMSetLowerBC",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Manager, Models",
              "CodeArray": [
                "using APSIM.Core;",
                "using APSIM.Shared.Utilities;",
                "using NetMQ.Sockets;",
                "using NetMQ;",
                "using System.Collections.Generic;",
                "using System.IO;",
                "using MessagePack;",
                "using Models.Functions;",
                "using Models.Utilities;",
                "using Models.Surface;",
                "using Models.Soils;",
                "using Models.PMF;",
                "using Models.Core;",
                "using System;",
                "using System.Linq;",
                "using Models.Soils.Nutrients;",
                "",
                "namespace Models",
                "{",
                "    [Serializable]",
                "    public class Script : Model, IStructureDependency",
                "    {",
                "        [Link] private Clock clock;",
                "        [Link] private Simulation simulation;",
                "        [Link] private Summary Summary;",
                "        [NonSerialized] private DealerSocket connection;",
                "        public IStructure Structure { private get; set; }",
                "",
                "        [Description(\"Identifier\")]",
                "        public string Identifier { get; set; }",
                "",
                "        [NonSerialized] private bool pausedAfterWaterToday = false;",
                "",
                "        ",
                "",
                "        [EventSubscribe(\"StartOfSimulation\")]",
                "        private void OnSimulationCommencing(object sender, EventArgs e)",
                "        {",
                "            if (Identifier == \"<undefined>\")",
                "            {",
                "                Console.WriteLine(\"Need an endpoint to connect to\");",
                "                Summary.WriteMessage(this, \"Need an endpoint to connect to\", MessageType.Error);",
                "                return;",
                "            }",
                "            Identifier = \"tcp://\" + Identifier;",
                "            connection = new DealerSocket(Identifier);",
                "            connection.SendFrame(\"connect\");",
                "            var msg = connection.ReceiveFrameString();",
                "            if (msg != \"ok\") throw new Exception(\"Expected ok\");",
                "        }",
                "",
                "        [EventSubscribe(\"StartOfDay\")]",
                "        private void OnStartOfDay(object s, EventArgs e) => pausedAfterWaterToday = false;",
                "",
                "        // --- Р В РЎСџР В Р’В°Р РЋРЎвЂњР В Р’В·Р В Р’В° Р РЋР С“Р РЋР вЂљР В Р’В°Р В Р’В·Р РЋРЎвЂњ Р В РЎвЂ”Р В РЎвЂўР РЋР С“Р В Р’В»Р В Р’Вµ DoSoilWaterMovement ---",
                "        [EventSubscribe(\"DoSoilWaterMovement\")]",
                "        private void OnAfterSoilWaterMovement(object s, EventArgs e)",
                "        {",
                "            if (connection == null || pausedAfterWaterToday) return;",
                "            pausedAfterWaterToday = true;",
                "",
                "            connection.SendFrame(\"paused1\");",
                "            bool moreToDo = true;",
                "            while (moreToDo)",
                "            {",
                "                var msg = connection.ReceiveMultipartMessage();",
                "                if (msg == null || msg.FrameCount == 0) continue;",
                "",
                "                var command = msg[0].ConvertToString();",
                "                switch (command)",
                "                {",
                "                    case \"resume1\":",
                "                        moreToDo = false;",
                "                        break;",
                "                    case \"put\":",
                "                        RequireParts(msg, 3, \"put\");",
                "                        ProcessPutCommand(msg);",
                "                        break;",
                "                    case \"get\":",
                "                        RequireParts(msg, 2, \"get\");",
                "                        ProcessReadCommand(msg);",
                "                        break;",
                "                    default:",
                "                        throw new Exception(\"Expected resume1/get/put/do during paused1, not '\" + command + \"'\");",
                "                }",
                "            }",
                "            Summary?.WriteMessage(this, \"Resumed after paused1\", MessageType.Information);",
                "        }",
                "",
                "        [EventSubscribe(\"EndOfDay\")]",
                "        private void OnEndOfDay(object sender, EventArgs e)",
                "        {",
                "            if (connection == null) return;",
                "",
                "            connection.SendFrame(\"paused\");",
                "            bool moreToDo = true;",
                "            while (moreToDo)",
                "            {",
                "                var msg = connection.ReceiveMultipartMessage();",
                "                if (msg == null || msg.FrameCount == 0) continue;",
                "",
                "                var command = msg[0].ConvertToString();",
                "                switch (command)",
                "                {",
                "                    case \"resume\":",
                "                        moreToDo = false;",
                "                        break;",
                "                    case \"put\":",
                "                        RequireParts(msg, 3, \"put\");",
                "                        ProcessPutCommand(msg);",
                "                        break;",
                "                    case \"get\":",
                "                        RequireParts(msg, 2, \"get\");",
                "                        ProcessReadCommand(msg);",
                "                        break;",
                "                    default:",
                "                        throw new Exception(\"Expected resume/get/put, not '\" + command + \"'\");",
                "                }",
                "            }",
                "        }",
                "",
                "        [EventSubscribe(\"EndOfSimulation\")]",
                "        private void OnSimulationEnding(object sender, EventArgs e)",
                "        {",
                "            if (connection == null) return;",
                "",
                "            connection.SendFrame(\"finished\");",
                "            var msg = connection.ReceiveFrameString();",
                "            if (msg != \"ok\") throw new Exception(\"Expected ok at end\");",
                "            connection.Close();",
                "            Console.WriteLine(\"Simulation Ending\");",
                "        }",
                "",
                "        // ==========================",
                "        //        Р В РЎвЂєР В Р’В±Р РЋРІР‚В°Р В РЎвЂР В Р’Вµ Р В РЎВР В Р’ВµР РЋРІР‚С™Р В РЎвЂўР В РўвЂР РЋРІР‚в„–",
                "        // ==========================",
                "",
                "        private void ProcessPutCommand(NetMQMessage msg)",
                "        {",
                "            // msg[1] Р Р†Р вЂљРІР‚Сњ packed string variableName; msg[2] Р Р†Р вЂљРІР‚Сњ packed object value",
                "            string variableName = MessagePackSerializer.Deserialize<string>(msg[1].Buffer);",
                "",
                "            // Р В Р’В§Р РЋРІР‚С™Р В РЎвЂў Р В Р’В·Р В Р’В° Р РЋРІР‚С™Р В РЎвЂР В РЎвЂ” Р РЋРЎвЂњ Р В РЎвЂ”Р В Р’ВµР РЋР вЂљР В Р’ВµР В РЎВР В Р’ВµР В Р вЂ¦Р В Р вЂ¦Р В РЎвЂўР В РІвЂћвЂ“ Р В Р вЂ  APSIM",
                "            var targetObj = Structure.Get(variableName, relativeTo: simulation);",
                "            if (targetObj == null)",
                "                throw new Exception($\"Variable '{variableName}' not found in simulation.\");",
                "            var targetType = targetObj.GetType();",
                "",
                "            object incoming = MessagePackSerializer.Deserialize<object>(msg[2].Buffer);",
                "",
                "            // Р В РЎСџР РЋР вЂљР В РЎвЂўР В Р вЂ Р В Р’ВµР РЋР вЂљР В РЎвЂќР В Р’В° Р РЋР С“Р В РЎвЂўР В РЎвЂ“Р В Р’В»Р В Р’В°Р РЋР С“Р В РЎвЂўР В Р вЂ Р В Р’В°Р В Р вЂ¦Р В Р вЂ¦Р В РЎвЂўР РЋР С“Р РЋРІР‚С™Р В РЎвЂ Р В РЎВР В Р’В°Р РЋР С“Р РЋР С“Р В РЎвЂР В Р вЂ /Р РЋР С“Р В РЎвЂќР В Р’В°Р В Р’В»Р РЋР РЏР РЋР вЂљ",
                "            if (incoming.GetType().IsArray != targetType.IsArray)",
                "                throw new Exception(\"Array/scalar mismatch for \" + variableName);",
                "",
                "            if (targetType.IsArray)",
                "            {",
                "                Type elemType = targetType.GetElementType();",
                "                var incomingArray = (incoming as object[]) ?? throw new Exception(\"Expected array payload for \" + variableName);",
                "",
                "                if (IsNumeric(elemType))",
                "                {",
                "                    var casted = Array.ConvertAll(incomingArray, e => (double)e);",
                "                    Structure.Set(variableName, casted, relativeTo: simulation);",
                "                }",
                "                else if (IsInteger(elemType))",
                "                {",
                "                    var casted = Array.ConvertAll(incomingArray, e => (int)e);",
                "                    Structure.Set(variableName, casted, relativeTo: simulation);",
                "                }",
                "                else if (IsString(elemType))",
                "                {",
                "                    var casted = Array.ConvertAll(incomingArray, e => (string)e);",
                "                    Structure.Set(variableName, casted, relativeTo: simulation);",
                "                }",
                "                else",
                "                {",
                "                    throw new Exception(\"Don't know what to do setting an array of \" + elemType);",
                "                }",
                "            }",
                "            else",
                "            {",
                "                Structure.Set(variableName, Convert.ChangeType(incoming, targetType), relativeTo: simulation);",
                "            }",
                "",
                "            connection.SendFrame(\"ok\");",
                "        }",
                "",
                "        private void ProcessReadCommand(NetMQMessage msg)",
                "        {",
                "            // msg[1] Р Р†Р вЂљРІР‚Сњ packed string variableName",
                "            string variableName = MessagePackSerializer.Deserialize<string>(msg[1].Buffer);",
                "",
                "            object value = Structure.Get(variableName, relativeTo: simulation);",
                "",
                "            if (value is IFunction fun)",
                "            {",
                "                value = fun.Value();",
                "            }",
                "            else if (value != null && (value.GetType().IsArray || value.GetType().IsClass))",
                "            {",
                "                try",
                "                {",
                "                    value = ReflectionUtilities.Clone(value);",
                "                }",
                "                catch (Exception err)",
                "                {",
                "                    throw new Exception(",
                "                        $\"Cannot report variable \\\"{variableName}\\\": Variable is a non-reportable type: \\\"{value?.GetType()?.Name}\\\".\", err);",
                "                }",
                "            }",
                "",
                "            byte[] bytes = MessagePackSerializer.Serialize(value ?? \"NA\");",
                "            connection.SendFrame(bytes);",
                "        }",
                "",
                "        private static void RequireParts(NetMQMessage msg, int expected, string cmd)",
                "        {",
                "            if (msg.FrameCount != expected)",
                "                throw new Exception($\"Command '{cmd}' expects {expected} frames, got {msg.FrameCount}.\");",
                "        }",
                "",
                "        private static bool IsNumeric(Type type)",
                "        {",
                "            switch (Type.GetTypeCode(type))",
                "            {",
                "                case TypeCode.Double:",
                "                case TypeCode.Single:",
                "                    return true;",
                "                default:",
                "                    return false;",
                "            }",
                "        }",
                "",
                "        private static bool IsInteger(Type type)",
                "        {",
                "            switch (Type.GetTypeCode(type))",
                "            {",
                "                case TypeCode.Int16:",
                "                case TypeCode.Int32:",
                "                case TypeCode.Int64:",
                "                case TypeCode.UInt16:",
                "                case TypeCode.UInt32:",
                "                case TypeCode.UInt64:",
                "                    return true;",
                "                default:",
                "                    return false;",
                "            }",
                "        }",
                "",
                "        private static bool IsString(Type type) => Type.GetTypeCode(type) == TypeCode.String;",
                "    }",
                "}",
                ""
              ],
              "Parameters": [
                {
                  "Key": "Identifier",
                  "Value": "<undefined>"
                }
              ],
              "Name": "Synchroniser",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            }
          ],
          "Enabled": true,
          "ReadOnly": false
        },
        {
          "$type": "Models.Core.Zone, Models",
          "Area": 1.0,
          "Slope": 0.0,
          "AspectAngle": 0.0,
          "Altitude": 50.0,
          "CanopyType": "BroadAcre",
          "Name": "Field8",
          "ResourceName": null,
          "Children": [
            {
              "$type": "Models.Report, Models",
              "VariableNames": [
                "[Clock].Today",
                "",
                "[Wheat].LAI as WheatLAI",
                "[Wheat].Phenology.Zadok.Stage as WheatZadok",
                "[Wheat].Phenology.CurrentStageName as WheatStage",
                "[Wheat].AboveGround.Wt as WheatAGWt",
                "[Wheat].AboveGround.N as WheatAGN",
                "[Wheat].Grain.Total.Wt*10 as WheatYield",
                "[Wheat].Grain.Protein as WheatProtein",
                "[Wheat].Grain.Size as WheatSize",
                "[Wheat].Grain.Number as WheatNumber",
                "[Wheat].Grain.Total.Wt as WheatGrainWt",
                "[Wheat].Grain.Total.N as WheatGrainN",
                "[Wheat].Total.Wt as WheatTotalWt",
                "",
                "[RedClover].LAI as CloverLAI",
                "[RedClover].Phenology.CurrentStageName as CloverStage",
                "[RedClover].AboveGround.Wt as CloverAGWt",
                "[RedClover].AboveGround.N as CloverAGN",
                "[RedClover].Total.Wt as CloverTotalWt",
                "[RedClover].AboveGround.Wt*10 as CloverYield",
                "",
                "[PlantainForage].LAI as PlantainLAI",
                "[PlantainForage].AboveGround.Wt as PlantainAGWt",
                "[PlantainForage].AboveGround.N as PlantainAGN",
                "[PlantainForage].Total.Wt as PlantainTotalWt",
                "[PlantainForage].AboveGround.Wt*10 as PlantainYield",
                "",
                "[RedClover].AboveGround.Wt + [PlantainForage].AboveGround.Wt as MixAGWt",
                "([RedClover].AboveGround.Wt + [PlantainForage].AboveGround.Wt)*10 as MixYield",
                "[RedClover].AboveGround.N + [PlantainForage].AboveGround.N as MixAGN",
                "",
                "[Oats].LAI as OatsLAI",
                "[Oats].Phenology.Zadok.Stage as OatsZadok",
                "[Oats].Phenology.CurrentStageName as OatsStage",
                "[Oats].AboveGround.Wt as OatsAGWt",
                "[Oats].AboveGround.N as OatsAGN",
                "[Oats].Grain.Total.Wt*10 as OatsYield",
                "[Oats].Grain.Total.Wt as OatsGrainWt",
                "[Oats].Total.Wt as OatsTotalWt",
                "",
                "[Potato].LAI as PotatoLAI",
                "[Potato].Phenology.CurrentStageName as PotatoStage",
                "[Potato].AboveGround.Wt as PotatoAGWt",
