# Show the available repository commands.
default:
    @just --list

# Format the workspace.
fmt:
    cargo fmt --all

# Check formatting without changing files.
fmt-check:
    cargo fmt --all --check

# Type-check every target with every feature enabled.
check:
    cargo check --workspace --all-targets --all-features

# Run Clippy across every target and reject warnings.
lint:
    cargo clippy --workspace --all-targets --all-features -- -D warnings

# Run all workspace tests with every feature enabled.
test:
    cargo test --workspace --all-features

# Build workspace documentation without dependency documentation.
doc:
    cargo doc --workspace --all-features --no-deps

# Run the complete pre-submission validation suite.
verify: fmt-check lint test doc

# Build optimized binary.
build-release:
    cargo build --release -p aquacrop-cli

# Run the optimized binary.
run *args:
    cargo run --release -p aquacrop-cli -- {{args}}

example-official-fixture:
    cargo run --example official_fixture --features=serde

# Squash-pull a tagged AquaCrop release into the subtree and update the generated version metadata.
pull-kul-rsda-aquacrop tag:
    #!/bin/sh
    set -eu

    prefix=third-party/KUL-RSDA/AquaCrop
    version_file=crates/aquacrop-core/src/version/generated.rs
    version_dir=$(dirname "$version_file")

    git subtree pull \
        --prefix="$prefix" \
        https://github.com/KUL-RSDA/AquaCrop.git \
        '{{tag}}' \
        --squash

    commit=$(
        git log "$before..HEAD" --format='%B' |
            sed -n 's/^git-subtree-split: //p'
    )

    version_tag=$(jq -r .version "$prefix/.zenodo.json")
    version=${version_tag#v}
    version_after_major=${version#*.}

    tmp=$(mktemp "$version_dir/.generated.rs.XXXXXX")
    trap 'rm -f "$tmp"' EXIT HUP INT TERM

    cat >"$tmp" <<EOF
    // @generated by \`just pull-kul-rsda-aquacrop {{tag}}\`. Do not edit manually.

    /// AquaCrop model version reproduced by this release.
    pub const AQUACROP_COMPATIBLE_VERSION: &str = "$version";

    /// AquaCrop major model version reproduced by this release.
    pub const AQUACROP_COMPATIBLE_VERSION_MAJOR: u16 = ${version%%.*};

    /// AquaCrop minor model version reproduced by this release.
    pub const AQUACROP_COMPATIBLE_VERSION_MINOR: u16 = ${version_after_major%%.*};

    /// Upstream AquaCrop source tag used as the numerical reference.
    pub const AQUACROP_REFERENCE_TAG: &str = "{{tag}}";

    /// Upstream AquaCrop source commit used as the numerical reference.
    pub const AQUACROP_REFERENCE_COMMIT: &str = "$commit";
    EOF

    mv "$tmp" "$version_file"
    trap - EXIT HUP INT TERM
