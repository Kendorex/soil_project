            },
            {
              "$type": "Models.PMF.Plant, Models",
              "Name": "Potato",
              "ResourceName": "Potato",
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.PMF.Plant, Models",
              "Name": "PlantainForage",
              "ResourceName": "PlantainForage",
              "Children": [
                {
                  "$type": "Models.PMF.Cultivar, Models",
                  "Command": [
                    "[Phenology].ThermalTime.Response.X = 15.0, 34.5, 45.0",
                    "[Phenology].ThermalTime.Response.Y = 0.0, 20.0, 0.0",
                    "[Leaf].Photosynthesis.FT.XYPairs.X = 15, 17, 22, 28, 34.5, 42, 45",
                    "[Leaf].Photosynthesis.FT.XYPairs.Y = 0, 0.0375, 0.225, 0.75, 0.75, 0.075, 0",
                    "[Leaf].BiomassRemovalDefaults.HarvestFractionLiveToRemove = 0.9",
                    "[Leaf].BiomassRemovalDefaults.HarvestFractionDeadToRemove = 0.9",
                    "[Leaf].BiomassRemovalDefaults.HarvestFractionLiveToResidue = 0",
                    "[Leaf].BiomassRemovalDefaults.HarvestFractionDeadToResidue = 0",
                    "[Stem].BiomassRemovalDefaults.HarvestFractionLiveToRemove = 0.9",
                    "[Stem].BiomassRemovalDefaults.HarvestFractionDeadToRemove = 0.9",
                    "[Stem].BiomassRemovalDefaults.HarvestFractionLiveToResidue = 0",
                    "[Stem].BiomassRemovalDefaults.HarvestFractionDeadToResidue = 0",
                    "[Inflorescence].BiomassRemovalDefaults.HarvestFractionLiveToRemove = 0.9",
                    "[Inflorescence].BiomassRemovalDefaults.HarvestFractionDeadToRemove = 0.9",
                    "[Inflorescence].BiomassRemovalDefaults.HarvestFractionLiveToResidue = 0",
                    "[Inflorescence].BiomassRemovalDefaults.HarvestFractionDeadToResidue = 0",
                    "[Root].BiomassRemovalDefaults.HarvestFractionLiveToRemove = 0",
                    "[Root].BiomassRemovalDefaults.HarvestFractionDeadToRemove = 0",
                    "[Root].BiomassRemovalDefaults.HarvestFractionLiveToResidue = 0",
                    "[Root].BiomassRemovalDefaults.HarvestFractionDeadToResidue = 0",
                    "[Taproot].BiomassRemovalDefaults.HarvestFractionLiveToRemove = 0",
                    "[Taproot].BiomassRemovalDefaults.HarvestFractionDeadToRemove = 0",
                    "[Taproot].BiomassRemovalDefaults.HarvestFractionLiveToResidue = 0",
                    "[Taproot].BiomassRemovalDefaults.HarvestFractionDeadToResidue = 0"
                  ],
                  "Name": "TimothyProxy",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                }
              ],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.PMF.Plant, Models",
              "Name": "Mustard",
              "ResourceName": "Canola",
              "Children": [
                {
                  "$type": "Models.PMF.Cultivar, Models",
                  "Command": [
                    "[Phenology].Vegetative.Target.XYPairs.X = 0, 25",
                    "[Phenology].Vegetative.Target.XYPairs.Y = 210, 1",
                    "",
                    "[Phenology].StemElongation.Target.PPResponse.Amount.FixedValue = 180",
                    "[Leaf].Phyllochron.Base.FixedValue = 55"
                  ],
                  "Name": "Mustard_sort",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                }
              ],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.PMF.Plant, Models",
              "Name": "Rape",
              "ResourceName": "Canola",
              "Children": [
                {
                  "$type": "Models.PMF.Cultivar, Models",
                  "Command": [
                    "[Phenology].Vegetative.Target.XYPairs.X = 0, 25",
                    "[Phenology].Vegetative.Target.XYPairs.Y = 290, 1",
                    "",
                    "[Phenology].StemElongation.Target.PPResponse.Amount.FixedValue = 240",
                    "[Leaf].Phyllochron.Base.FixedValue = 65"
                  ],
                  "Name": "Rape_sort",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                }
              ],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Manager, Models",
              "CodeArray": [
                "using System;",
                "using System.Linq;",
                "using System.Globalization;",
                "using System.Collections.Generic;",
                "using APSIM.Core;",
                "using APSIM.Shared.Utilities;",
                "using Models.Core;",
                "using Models.PMF;",
                "using Models.PMF.Interfaces;",
                "",
                "namespace Models",
                "{",
                "    [Serializable]",
                "    public class Script : Model, IStructureDependency",
                "    {",
                "        public IStructure Structure { private get; set; }",
                "        [Link] private Clock Clock;",
                "        [Link] private Summary Summary;",
                "        [Link(ByName = true)] private Plant Wheat;",
                "        [Link(ByName = true)] private Plant Oats;",
                "        [Link(ByName = true)] private Plant RedClover;",
                "        [Link(ByName = true)] private Plant PlantainForage;",
                "        [Link(ByName = true)] private Plant Rape;",
                "        [Link(ByName = true)] private Plant Mustard;",
                "        [Description(\"Crop groups for each harvest year, starting with the simulation start year\")]",
                "        public string[] RotationCrops { get; set; }",
                "        [Description(\"Cultivars for each year; mixture components separated by semicolons\")]",
                "        public string[] RotationCultivars { get; set; }",
                "        [Description(\"Sowing depths in mm for each year and mixture component\")]",
                "        public string[] RotationSowingDepths { get; set; }",
                "        [Description(\"Row spacings in mm for each year and mixture component\")]",
                "        public string[] RotationRowSpacings { get; set; }",
                "        [Description(\"Populations per square metre for each year and mixture component\")]",
                "        public string[] RotationPopulations { get; set; }",
                "        [Description(\"Sowing dates by harvest year; dd-MMM, or dash for established pasture\")]",
                "        public string[] RotationSowingDates { get; set; }",
                "        [Description(\"Harvest or cutting dates for each year; dd-MMM\")]",
                "        public string[] RotationHarvestDates { get; set; }",
                "        [Description(\"Crop names harvested in each year; mixture components separated by plus\")]",
                "        public string[] RotationHarvestCrops { get; set; }",
                "        [Description(\"Harvest use for each year: grain, hay or green\")]",
                "        public string[] RotationUses { get; set; }",
                "        [Description(\"Pasture year of use for each harvest year; zero for annual crops\")]",
                "        public string[] PastureAges { get; set; }",
                "        [Description(\"Date to terminate outgoing pasture before the next annual crop; dd-MMM\")]",
                "        public string TerminationDate { get; set; } = \"20-Aug\";",
                "        [Description(\"Date to transfer winter shoot dieback to residues; dd-MMM\")]",
                "        public string WinterDiebackDate { get; set; } = \"01-Dec\";",
                "        public double HarvestDMKgHa { get; private set; }",
                "        public double HarvestDMTHa { get { return HarvestDMKgHa / 1000.0; } }",
                "        public double BiomassBeforeKgHa { get; private set; }",
                "        public double BiomassAfterKgHa { get; private set; }",
                "        public double YieldThisYearKgHa { get; private set; }",
                "        public string HarvestCrop { get; private set; }",
                "        public string HarvestUse { get; private set; }",
                "        public int HarvestYear { get; private set; }",
                "        public event EventHandler HarvestRecorded;",
                "        private Dictionary<string, Plant> plants;",
                "        private DateTime? undersowDate;",
                "        private int firstYear, lastYear;",
                "",
                "        [EventSubscribe(\"StartOfSimulation\")]",
                "        private void Start(object sender, EventArgs e)",
                "        {",
                "            firstYear = lastYear = Clock.StartDate.Year;",
                "            plants = new Dictionary<string, Plant> {",
                "                {\"Wheat\", Wheat}, {\"Oats\", Oats}, {\"RedClover\", RedClover},",
                "                {\"PlantainForage\", PlantainForage}, {\"Rape\", Rape}, {\"Mustard\", Mustard}};",
                "            int n = RotationCrops.Length;",
                "            if (new [] {RotationCultivars.Length, RotationSowingDepths.Length,",
                "                RotationRowSpacings.Length, RotationPopulations.Length,",
                "                RotationSowingDates.Length, RotationHarvestDates.Length,",
                "                RotationHarvestCrops.Length, RotationUses.Length, PastureAges.Length}.Any(v => v != n))",
                "                throw new Exception(\"Rotation arrays must have equal lengths\");",
                "            for (int i=0; i<n; i++)",
                "            {",
                "                int count = Parts(RotationCrops[i], '+').Length;",
                "                foreach (string spec in new [] {RotationCultivars[i], RotationSowingDepths[i], RotationRowSpacings[i], RotationPopulations[i]})",
                "                    if (Parts(spec, ';').Length != count) throw new Exception(\"Mixture parameter count mismatch, year \" + (firstYear+i));",
                "            }",
                "            if (Hay(0) || Winter(0))",
                "            {",
                "                Sow(0, false, false);",
                "                Summary.WriteMessage(this, \"INITIAL STATE APPROXIMATION: pre-2019 crop represented by sowing on simulation start; 2018 weather and established biomass are unavailable.\", MessageType.Warning);",
                "            }",
                "        }",
                "",
                "        [EventSubscribe(\"DoManagement\")]",
                "        private void Manage(object sender, EventArgs e)",
                "        {",
                "            int i = Clock.Today.Year-firstYear;",
                "            if (i<0 || i>=RotationCrops.Length) return;",
                "            if (lastYear != Clock.Today.Year) { YieldThisYearKgHa=0; lastYear=Clock.Today.Year; }",
                "            if (undersowDate.HasValue && Clock.Today == undersowDate.Value)",
                "            {",
                "                Sow(i, true, true);",
                "                undersowDate=null;",
                "            }",
                "            if (!Hay(i) && !Winter(i) && Match(RotationSowingDates[i]))",
                "            {",
                "                EndAll();",
                "                Sow(i, false, true);",
                "                if (Parts(RotationCrops[i], '+').Any(Perennial)) undersowDate=Clock.Today.AddDays(1);",
                "            }",
                "            if (Match(RotationHarvestDates[i])) Harvest(i);",
                "            int next=i+1;",
                "            // Terminate only the outgoing sward, including a third-year sward.",
                "            // A second-year sward followed by a third year remains alive.",
                "            if (Hay(i) && next<RotationCrops.Length && !Hay(next) && Match(TerminationDate)) EndAll();",
                "            if (next<RotationCrops.Length && Winter(next) && Match(RotationSowingDates[next]))",
                "            {",
                "                EndAll();",
                "                Sow(next, false, false);",
                "            }",
                "            // Explicit approximation of winter shoot loss: send it to residues,",
                "            // preserve roots/reserves and never add it to harvested yield.",
                "            // No operations in the oats establishment year after oats harvest.",
                "            if (Hay(i) && next<RotationCrops.Length && Hay(next) && Match(WinterDiebackDate))",
                "                foreach (Plant p in plants.Values.Where(p => Perennial(p.Name) && p.IsAlive))",
                "                    foreach (var organ in AbovegroundOrgans(p)) organ.RemoveBiomass(0,0,1,1);",
                "        }",
                "",
                "        private static string[] Parts(string value, char sep) { return value.Split(sep).Select(s=>s.Trim()).ToArray(); }",
                "        private bool Match(string date) { return date!=\"-\" && DateUtilities.WithinDates(date, Clock.Today, date); }",
                "        private bool Hay(int i) { return RotationUses[i]==\"hay\"; }",
                "        private bool Winter(int i) { return RotationCultivars[i].Contains(\"Winter_rye\"); }",
                "        private static bool Perennial(string name) { return name==\"RedClover\" || name==\"PlantainForage\"; }",
                "        private IEnumerable<IHasDamageableBiomass> AbovegroundOrgans(Plant plant)",
                "        {",
                "            return Structure.FindChildren<IHasDamageableBiomass>(relativeTo:plant)",
                "                .Where(o => new [] {\"Leaf\",\"Petiole\",\"Stem\",\"Inflorescence\",\"Panicle\",\"Grain\"}.Contains(((IModel)o).Name));",
                "        }",
                "        private void Sow(int i, bool perennialsOnly, bool splitMixture)",
                "        {",
                "            var names=Parts(RotationCrops[i], '+');",
                "            var cultivars=Parts(RotationCultivars[i], ';');",
                "            var depths=Parts(RotationSowingDepths[i], ';');",
                "            var rows=Parts(RotationRowSpacings[i], ';');",
                "            var pops=Parts(RotationPopulations[i], ';');",
                "            for(int c=0;c<names.Length;c++)",
                "            {",
                "                if (splitMixture && Perennial(names[c])!=perennialsOnly) continue;",
                "                Plant p=plants[names[c]];",
                "                if(p.IsAlive) throw new Exception(\"Attempt to resow living crop \" + p.Name);",
                "                p.Sow(cultivar:cultivars[c], population:double.Parse(pops[c],CultureInfo.InvariantCulture),",
                "                    depth:double.Parse(depths[c],CultureInfo.InvariantCulture), rowSpacing:double.Parse(rows[c],CultureInfo.InvariantCulture));",
                "                Summary.WriteMessage(this, \"SOW \" + p.Name + \" \" + cultivars[c] + \" \" + Clock.Today.ToString(\"yyyy-MM-dd\"), MessageType.Information);",
                "            }",
                "        }",
                "        private void Harvest(int i)",
                "        {",
                "            HarvestDMKgHa=BiomassBeforeKgHa=BiomassAfterKgHa=0;",
                "            HarvestYear=Clock.Today.Year;",
                "            HarvestCrop=RotationHarvestCrops[i]; HarvestUse=RotationUses[i];",
                "            foreach(string name in Parts(HarvestCrop,'+'))",
                "            {",
                "                Plant p=plants[name];",
                "                if(!p.IsAlive) throw new Exception(\"Scheduled harvest of absent crop \" + name);",
                "                double before=p.AboveGround.Wt*10;",
                "                BiomassBeforeKgHa+=before;",
                "                if(HarvestUse==\"grain\")",
                "                    HarvestDMKgHa+=Convert.ToDouble(Structure.Get(\"Grain.Total.Wt\", relativeTo:p))*10;",
                "                p.Harvest();",
                "                double after=p.AboveGround.Wt*10;",
                "                BiomassAfterKgHa+=after;",
                "                if(HarvestUse!=\"grain\") HarvestDMKgHa+=Math.Max(0,before-after);",
                "                if(!Perennial(name) || HarvestUse==\"green\") p.EndCrop();",
                "            }",
                "            YieldThisYearKgHa+=HarvestDMKgHa;",
                "            Summary.WriteMessage(this, \"HARVEST \" + HarvestCrop + \" \" + Clock.Today.ToString(\"yyyy-MM-dd\") + \" DM kg/ha=\" + HarvestDMKgHa.ToString(\"F2\",CultureInfo.InvariantCulture), MessageType.Information);",
                "            HarvestRecorded?.Invoke(this, EventArgs.Empty);",
                "        }",
                "        private void EndAll()",
                "        {",
                "            foreach(Plant p in plants.Values.Where(p=>p.IsAlive))",
                "            {",
                "                Summary.WriteMessage(this,\"END \" + p.Name + \" \" + Clock.Today.ToString(\"yyyy-MM-dd\"),MessageType.Information);",
                "                p.EndCrop();",
                "            }",
                "        }",
                "    }",
                "}"
              ],
              "Parameters": [
                {
                  "Key": "RotationCrops",
                  "Value": "RedClover+PlantainForage, Mustard, Wheat, Oats+RedClover+PlantainForage, RedClover+PlantainForage"
                },
                {
                  "Key": "RotationCultivars",
                  "Value": "LocalClover;TimothyProxy, Mustard_sort, Zlata, Yakov;LocalClover;TimothyProxy, LocalClover;TimothyProxy"
                },
                {
                  "Key": "RotationSowingDepths",
                  "Value": "10;10, 20, 20, 20;10;10, 10;10"
                },
                {
                  "Key": "RotationRowSpacings",
                  "Value": "150;150, 150, 150, 150;150;150, 150;150"
                },
                {
                  "Key": "RotationPopulations",
                  "Value": "450;300, 200, 200, 250;150;150, 450;300"
                },
                {
                  "Key": "RotationSowingDates",
                  "Value": "-, 10-May, 18-May, 12-May, -"
                },
                {
                  "Key": "RotationHarvestDates",
                  "Value": "15-Jul, 31-Aug, 16-Aug, 31-Aug, 15-Jul"
                },
                {
                  "Key": "RotationHarvestCrops",
                  "Value": "RedClover+PlantainForage, Mustard, Wheat, Oats, RedClover+PlantainForage"
                },
                {
                  "Key": "RotationUses",
                  "Value": "hay, grain, grain, grain, hay"
                },
                {
                  "Key": "PastureAges",
                  "Value": "3, 0, 0, 0, 1"
                },
                {
                  "Key": "TerminationDate",
                  "Value": "20-Aug"
                },
                {
                  "Key": "WinterDiebackDate",
                  "Value": "01-Dec"
                }
              ],
              "Name": "RotationManager",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Manager, Models",
              "CodeArray": [
                "using System;",
                "using System.Collections.Generic;",
                "using Models.Core;",
                "using Models.PMF;",
                "using Models.Soils.Nutrients;",
                "",
                "namespace Models",
                "{",
                "    [Serializable]",
                "    public class Script : Model",
                "    {",
                "        [Link] private Clock Clock;",
                "        [Link] private Fertiliser Fertiliser;",
                "        [Link] private Summary Summary;",
                "",
                "        [Description(\"Fertiliser type for each year of rotation (same order as rotation years)\")]",
                "        public string[] FertiliserTypes { get; set; }",
                "",
                "        [Description(\"Amount of fertiliser for each year of rotation (kg/ha), same order\")]",
                "        public double[] FertiliserAmounts { get; set; }",
                "",
                "        [Description(\"Apply fertiliser only at sowing of these crops (leave empty = all sowings)\")]",
                "        public string[] ApplyAtCrops { get; set; }",
                "",
                "        private int startYear;",
                "        private HashSet<string> fertilisedToday = new HashSet<string>();",
                "",
                "        [EventSubscribe(\"StartOfSimulation\")]",
                "        private void OnStart(object sender, EventArgs e)",
                "        {",
                "            startYear = Clock.StartDate.Year;",
                "        }",
                "",
                "        [EventSubscribe(\"Sowing\")]",
                "        private void OnSowing(object sender, EventArgs e)",
                "        {",
                "            int yearIndex = Clock.Today.Year - Clock.StartDate.Year;",
                "            Plant crop = sender as Plant;",
                "            // Arrays refer to the harvest year. Autumn-sown rye belongs to next year.",
                "            if (crop != null && crop.SowingData.Cultivar != null &&",
                "                crop.SowingData.Cultivar.Contains(\"Winter_rye\") && Clock.Today.Month >= 7)",
                "                yearIndex++;",
                "            if (yearIndex < 0 || yearIndex >= FertiliserAmounts.Length)",
                "                return;",
                "",
                "            // If ApplyAtCrops specified, only fertilise at sowing of those crops",
                "            if (ApplyAtCrops != null && ApplyAtCrops.Length > 0)",
                "            {",
                "                string sownCrop = (sender as Plant)?.Name ?? \"\";",
                "                bool match = false;",
                "                foreach (string c in ApplyAtCrops)",
                "                    if (string.Equals(c, sownCrop, StringComparison.OrdinalIgnoreCase))",
                "                    { match = true; break; }",
                "                if (!match)",
                "                    return;",
                "            }",
                "",
                "            // Prevent double application on the same day (e.g. when sowing a mixture)",
                "            string key = Clock.Today.ToString(\"yyyy-MM-dd\");",
                "            if (fertilisedToday.Contains(key))",
                "                return;",
                "",
                "            double amount = FertiliserAmounts[yearIndex];",
                "            if (amount <= 0)",
                "                return;",
                "",
                "            string type = FertiliserTypes != null && yearIndex < FertiliserTypes.Length",
                "                ? FertiliserTypes[yearIndex]",
                "                : \"Urea\";",
                "",
                "            Fertiliser.Apply(amount: amount, type: type);",
                "            fertilisedToday.Add(key);",
                "            Summary.WriteMessage(this, $\"Applied {amount} kg/ha of {type} on {Clock.Today:d}\", MessageType.Information);",
                "        }",
                "    }",
                "}"
              ],
              "Parameters": [
                {
                  "Key": "FertiliserTypes",
                  "Value": "NH4NO3N, NH4NO3N, NH4NO3N, NH4NO3N, NH4NO3N"
                },
                {
                  "Key": "FertiliserAmounts",
                  "Value": "60, 60, 60, 60, 60"
                },
                {
                  "Key": "ApplyAtCrops",
                  "Value": "Wheat, Oats, Mustard, Rape"
                }
              ],
              "Name": "Fertilise at sowing",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Manager, Models",
              "CodeArray": [
                "using APSIM.Shared.Utilities;",
                "using Models.Utilities;",
                "using Models.Soils;",
                "using Models.PMF;",
                "using Models.Core;",
                "using System;",
                "using System.Linq;",
                "",
                "namespace Models",
                "{",
                "    [Serializable] ",
                "    public class Script : Model",
                "    {",
                "        [Description(\"Crop\")]",
                "        public IPlant Crop { get; set; }",
                "        ",
                "        [EventSubscribe(\"DoManagement\")]",
                "        private void OnDoManagement(object sender, EventArgs e)",
                "        {",
                "            if (Crop.IsReadyForHarvesting)",
                "            {",
                "                Crop.Harvest();",
                "                Crop.EndCrop();",
                "            }",
                "        }",
                "    }",
                "}",
                "       "
              ],
              "Parameters": [
                {
                  "Key": "Crop",
                  "Value": "[Wheat]"
                }
              ],
              "Name": "Harvest",
              "ResourceName": null,
              "Children": [],
              "Enabled": false,
              "ReadOnly": false
            },
            {
              "$type": "Models.Manager, Models",
              "CodeArray": [
                "using Models.Climate;",
                "using APSIM.Shared.Utilities;",
                "using Models.Soils.Nutrients;",
                "using Models.Soils;",
                "using Models.PMF;",
                "using Models.Core;",
                "using System.Xml.Serialization;",
                "using System;",
                "using System.Linq;",
                "using Models.AgPasture;",
                "using Models.Interfaces;",
                "",
                "namespace Models",
                "{",
                "    [Serializable] ",
                "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                "    public class Script : Model",
                "    {",
                "        [Link] Clock clock;",
                "        [Link] ISummary summary;",
                "        [Link] private Swim3 swim;",
                "        //[Link] private PastureSpecies ryegrass;",
                "        //[Link] private SimpleGrazing grazing;",
                "        ",
                "        public enum LowerBCTypeOptions {gradient,seepage,potential};",
                "",
                "        [Separator(\"Sets the lower boundary condition type (and value if set to 'potential' for SWIM3. The change is applied at the beginning of the first day of the simulation.\")]",
                "        [Description(\"[Get a dropdown] What lower boundary condition is wanted?\")] public LowerBCTypeOptions LowerBCType { get; set; }",
                "        [Description(\"If 'potential', then what potential? (mm) \")] public double LowerBCValue { get; set; }",
                "",
                "        public double SoilWaterStart  { get; set; }",
                "        public double SoilWaterEnd  { get; set; }",
                "",
                "        [EventSubscribe(\"DoDailyInitialisation\")]",
                "        private void DoDailyInitialisation(object sender, EventArgs e)",
                "        {",
                "        }",
                "",
                "        [EventSubscribe(\"DoReportCalculations\")]",
                "        private void DoReportCalculations(object sender, EventArgs e)",
                "        {",
                "        }",
                "",
                "        [EventSubscribe(\"DoManagement\")]",
                "        private void DoDailyCalculations(object sender, EventArgs e)",
                "        {",
                "            if (clock.Today == clock.StartDate)",
                "            {",
                "                summary.WriteMessage(this, \"Script is setting lower boundary condition to \" + LowerBCType, MessageType.Diagnostic);",
                "                if (LowerBCType == LowerBCTypeOptions.gradient)",
                "                    swim.SetLowerBCForGradient(bbcGradient: 0.0);   // in cm/cm (ibbc=0) Note that this is the default setting",
                "                else if (LowerBCType == LowerBCTypeOptions.potential)",
                "                    swim.SetLowerBCForGivenPotential(bbcPotential: LowerBCValue /10.0 );    //  convert to cm (ibbc=1), DUL is -100 cm so values more positive will often result in inflow to the bottom of the soil profile. Input in mm so divide here.",
                "                else if (LowerBCType == LowerBCTypeOptions.seepage)",
                "                    swim.SetLowerBCForSeepage(bbcPotentialSeepage: 0.0);  // in cm (ibbc=3). This is for zero-tension lysimeters",
                "                else",
                "                    throw new Exception(\"Wrong lower boundary condition type\");",
                "            }",
                "        }",
                "    }",
                "}"
              ],
              "Parameters": [
                {
                  "Key": "LowerBCType",
                  "Value": "seepage"
                },
                {
                  "Key": "LowerBCValue",
                  "Value": "-500"
                }
              ],
              "Name": "SWIMSetLowerBC",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Manager, Models",
              "CodeArray": [
                "using APSIM.Core;",
                "using APSIM.Shared.Utilities;",
                "using NetMQ.Sockets;",
                "using NetMQ;",
                "using System.Collections.Generic;",
                "using System.IO;",
                "using MessagePack;",
                "using Models.Functions;",
                "using Models.Utilities;",
                "using Models.Surface;",
                "using Models.Soils;",
                "using Models.PMF;",
                "using Models.Core;",
                "using System;",
                "using System.Linq;",
                "using Models.Soils.Nutrients;",
                "",
                "namespace Models",
                "{",
                "    [Serializable]",
                "    public class Script : Model, IStructureDependency",
                "    {",
                "        [Link] private Clock clock;",
                "        [Link] private Simulation simulation;",
                "        [Link] private Summary Summary;",
                "        [NonSerialized] private DealerSocket connection;",
                "        public IStructure Structure { private get; set; }",
                "",
                "        [Description(\"Identifier\")]",
                "        public string Identifier { get; set; }",
                "",
                "        [NonSerialized] private bool pausedAfterWaterToday = false;",
                "",
                "        ",
                "",
                "        [EventSubscribe(\"StartOfSimulation\")]",
                "        private void OnSimulationCommencing(object sender, EventArgs e)",
                "        {",
                "            if (Identifier == \"<undefined>\")",
                "            {",
                "                Console.WriteLine(\"Need an endpoint to connect to\");",
                "                Summary.WriteMessage(this, \"Need an endpoint to connect to\", MessageType.Error);",
                "                return;",
                "            }",
                "            Identifier = \"tcp://\" + Identifier;",
                "            connection = new DealerSocket(Identifier);",
                "            connection.SendFrame(\"connect\");",
                "            var msg = connection.ReceiveFrameString();",
                "            if (msg != \"ok\") throw new Exception(\"Expected ok\");",
                "        }",
                "",
                "        [EventSubscribe(\"StartOfDay\")]",
                "        private void OnStartOfDay(object s, EventArgs e) => pausedAfterWaterToday = false;",
                "",
                "        // --- Р В РЎСџР В Р’В°Р РЋРЎвЂњР В Р’В·Р В Р’В° Р РЋР С“Р РЋР вЂљР В Р’В°Р В Р’В·Р РЋРЎвЂњ Р В РЎвЂ”Р В РЎвЂўР РЋР С“Р В Р’В»Р В Р’Вµ DoSoilWaterMovement ---",
                "        [EventSubscribe(\"DoSoilWaterMovement\")]",
                "        private void OnAfterSoilWaterMovement(object s, EventArgs e)",
                "        {",
                "            if (connection == null || pausedAfterWaterToday) return;",
                "            pausedAfterWaterToday = true;",
                "",
                "            connection.SendFrame(\"paused1\");",
                "            bool moreToDo = true;",
                "            while (moreToDo)",
                "            {",
                "                var msg = connection.ReceiveMultipartMessage();",
                "                if (msg == null || msg.FrameCount == 0) continue;",
                "",
                "                var command = msg[0].ConvertToString();",
                "                switch (command)",
                "                {",
                "                    case \"resume1\":",
                "                        moreToDo = false;",
                "                        break;",
                "                    case \"put\":",
                "                        RequireParts(msg, 3, \"put\");",
                "                        ProcessPutCommand(msg);",
                "                        break;",
                "                    case \"get\":",
                "                        RequireParts(msg, 2, \"get\");",
                "                        ProcessReadCommand(msg);",
                "                        break;",
                "                    default:",
                "                        throw new Exception(\"Expected resume1/get/put/do during paused1, not '\" + command + \"'\");",
                "                }",
                "            }",
                "            Summary?.WriteMessage(this, \"Resumed after paused1\", MessageType.Information);",
                "        }",
                "",
                "        [EventSubscribe(\"EndOfDay\")]",
                "        private void OnEndOfDay(object sender, EventArgs e)",
                "        {",
                "            if (connection == null) return;",
                "",
                "            connection.SendFrame(\"paused\");",
                "            bool moreToDo = true;",
                "            while (moreToDo)",
                "            {",
                "                var msg = connection.ReceiveMultipartMessage();",
                "                if (msg == null || msg.FrameCount == 0) continue;",
                "",
                "                var command = msg[0].ConvertToString();",
                "                switch (command)",
                "                {",
                "                    case \"resume\":",
                "                        moreToDo = false;",
                "                        break;",
                "                    case \"put\":",
                "                        RequireParts(msg, 3, \"put\");",
                "                        ProcessPutCommand(msg);",
                "                        break;",
                "                    case \"get\":",
                "                        RequireParts(msg, 2, \"get\");",
                "                        ProcessReadCommand(msg);",
                "                        break;",
                "                    default:",
                "                        throw new Exception(\"Expected resume/get/put, not '\" + command + \"'\");",
                "                }",
                "            }",
                "        }",
                "",
                "        [EventSubscribe(\"EndOfSimulation\")]",
                "        private void OnSimulationEnding(object sender, EventArgs e)",
                "        {",
                "            if (connection == null) return;",
                "",
                "            connection.SendFrame(\"finished\");",
                "            var msg = connection.ReceiveFrameString();",
                "            if (msg != \"ok\") throw new Exception(\"Expected ok at end\");",
                "            connection.Close();",
                "            Console.WriteLine(\"Simulation Ending\");",
                "        }",
                "",
                "        // ==========================",
                "        //        Р В РЎвЂєР В Р’В±Р РЋРІР‚В°Р В РЎвЂР В Р’Вµ Р В РЎВР В Р’ВµР РЋРІР‚С™Р В РЎвЂўР В РўвЂР РЋРІР‚в„–",
                "        // ==========================",
                "",
                "        private void ProcessPutCommand(NetMQMessage msg)",
                "        {",
                "            // msg[1] Р Р†Р вЂљРІР‚Сњ packed string variableName; msg[2] Р Р†Р вЂљРІР‚Сњ packed object value",
                "            string variableName = MessagePackSerializer.Deserialize<string>(msg[1].Buffer);",
                "",
                "            // Р В Р’В§Р РЋРІР‚С™Р В РЎвЂў Р В Р’В·Р В Р’В° Р РЋРІР‚С™Р В РЎвЂР В РЎвЂ” Р РЋРЎвЂњ Р В РЎвЂ”Р В Р’ВµР РЋР вЂљР В Р’ВµР В РЎВР В Р’ВµР В Р вЂ¦Р В Р вЂ¦Р В РЎвЂўР В РІвЂћвЂ“ Р В Р вЂ  APSIM",
                "            var targetObj = Structure.Get(variableName, relativeTo: simulation);",
                "            if (targetObj == null)",
                "                throw new Exception($\"Variable '{variableName}' not found in simulation.\");",
                "            var targetType = targetObj.GetType();",
                "",
                "            object incoming = MessagePackSerializer.Deserialize<object>(msg[2].Buffer);",
                "",
                "            // Р В РЎСџР РЋР вЂљР В РЎвЂўР В Р вЂ Р В Р’ВµР РЋР вЂљР В РЎвЂќР В Р’В° Р РЋР С“Р В РЎвЂўР В РЎвЂ“Р В Р’В»Р В Р’В°Р РЋР С“Р В РЎвЂўР В Р вЂ Р В Р’В°Р В Р вЂ¦Р В Р вЂ¦Р В РЎвЂўР РЋР С“Р РЋРІР‚С™Р В РЎвЂ Р В РЎВР В Р’В°Р РЋР С“Р РЋР С“Р В РЎвЂР В Р вЂ /Р РЋР С“Р В РЎвЂќР В Р’В°Р В Р’В»Р РЋР РЏР РЋР вЂљ",
                "            if (incoming.GetType().IsArray != targetType.IsArray)",
                "                throw new Exception(\"Array/scalar mismatch for \" + variableName);",
                "",
                "            if (targetType.IsArray)",
                "            {",
                "                Type elemType = targetType.GetElementType();",
                "                var incomingArray = (incoming as object[]) ?? throw new Exception(\"Expected array payload for \" + variableName);",
                "",
                "                if (IsNumeric(elemType))",
                "                {",
                "                    var casted = Array.ConvertAll(incomingArray, e => (double)e);",
                "                    Structure.Set(variableName, casted, relativeTo: simulation);",
                "                }",
                "                else if (IsInteger(elemType))",
                "                {",
                "                    var casted = Array.ConvertAll(incomingArray, e => (int)e);",
                "                    Structure.Set(variableName, casted, relativeTo: simulation);",
                "                }",
                "                else if (IsString(elemType))",
                "                {",
                "                    var casted = Array.ConvertAll(incomingArray, e => (string)e);",
                "                    Structure.Set(variableName, casted, relativeTo: simulation);",
                "                }",
                "                else",
                "                {",
                "                    throw new Exception(\"Don't know what to do setting an array of \" + elemType);",
                "                }",
                "            }",
                "            else",
                "            {",
                "                Structure.Set(variableName, Convert.ChangeType(incoming, targetType), relativeTo: simulation);",
                "            }",
                "",
                "            connection.SendFrame(\"ok\");",
                "        }",
                "",
                "        private void ProcessReadCommand(NetMQMessage msg)",
                "        {",
                "            // msg[1] Р Р†Р вЂљРІР‚Сњ packed string variableName",
                "            string variableName = MessagePackSerializer.Deserialize<string>(msg[1].Buffer);",
                "",
                "            object value = Structure.Get(variableName, relativeTo: simulation);",
                "",
                "            if (value is IFunction fun)",
                "            {",
                "                value = fun.Value();",
                "            }",
                "            else if (value != null && (value.GetType().IsArray || value.GetType().IsClass))",
                "            {",
                "                try",
                "                {",
                "                    value = ReflectionUtilities.Clone(value);",
                "                }",
                "                catch (Exception err)",
                "                {",
                "                    throw new Exception(",
                "                        $\"Cannot report variable \\\"{variableName}\\\": Variable is a non-reportable type: \\\"{value?.GetType()?.Name}\\\".\", err);",
                "                }",
                "            }",
                "",
                "            byte[] bytes = MessagePackSerializer.Serialize(value ?? \"NA\");",
                "            connection.SendFrame(bytes);",
                "        }",
                "",
                "        private static void RequireParts(NetMQMessage msg, int expected, string cmd)",
                "        {",
                "            if (msg.FrameCount != expected)",
                "                throw new Exception($\"Command '{cmd}' expects {expected} frames, got {msg.FrameCount}.\");",
                "        }",
                "",
                "        private static bool IsNumeric(Type type)",
                "        {",
                "            switch (Type.GetTypeCode(type))",
                "            {",
                "                case TypeCode.Double:",
                "                case TypeCode.Single:",
                "                    return true;",
                "                default:",
                "                    return false;",
                "            }",
                "        }",
                "",
                "        private static bool IsInteger(Type type)",
                "        {",
                "            switch (Type.GetTypeCode(type))",
                "            {",
                "                case TypeCode.Int16:",
                "                case TypeCode.Int32:",
                "                case TypeCode.Int64:",
                "                case TypeCode.UInt16:",
                "                case TypeCode.UInt32:",
                "                case TypeCode.UInt64:",
                "                    return true;",
                "                default:",
                "                    return false;",
                "            }",
                "        }",
                "",
                "        private static bool IsString(Type type) => Type.GetTypeCode(type) == TypeCode.String;",
                "    }",
                "}",
                ""
              ],
              "Parameters": [
                {
                  "Key": "Identifier",
                  "Value": "<undefined>"
                }
              ],
              "Name": "Synchroniser",
              "ResourceName": null,
              "Children": [],
              "Enabled": false,
              "ReadOnly": false
            },
            {
              "$type": "Models.Report, Models",
              "Name": "HarvestReport",
              "Enabled": true,
              "Children": [],
              "VariableNames": [
                "[Clock].Today as Date",
                "[RotationManager].Script.HarvestYear as Year",
                "[RotationManager].Script.HarvestCrop as Crop",
                "[RotationManager].Script.HarvestUse as Use",
                "[RotationManager].Script.HarvestDMKgHa as YieldDMKgHa",
                "[RotationManager].Script.HarvestDMTHa as YieldDMTHa",
                "[RotationManager].Script.BiomassBeforeKgHa as BeforeKgHa",
                "[RotationManager].Script.BiomassAfterKgHa as AfterKgHa"
              ],
              "EventNames": [
                "[RotationManager].Script.HarvestRecorded"
              ]
            }
          ],
          "Enabled": true,
          "ReadOnly": false
        },
        {
          "$type": "Models.Graph, Models",
          "Caption": null,
          "Axis": [
            {
              "$type": "APSIM.Shared.Graphing.Axis, APSIM.Shared",
              "Title": null,
              "Position": 3,
              "Inverted": false,
              "CrossesAtZero": false,
              "LabelOnOneLine": false,
              "Minimum": null,
              "Maximum": null,
              "Interval": null
            },
            {
              "$type": "APSIM.Shared.Graphing.Axis, APSIM.Shared",
              "Title": null,
              "Position": 0,
              "Inverted": false,
              "CrossesAtZero": false,
              "LabelOnOneLine": false,
              "Minimum": null,
              "Maximum": null,
              "Interval": null
            }
          ],
          "LegendPosition": 0,
          "LegendOrientation": 0,
          "AnnotationLocation": 0,
          "DisabledSeries": [],
          "LegendOutsideGraph": false,
          "Name": "Graph",
          "ResourceName": null,
          "Children": [
            {
              "$type": "Models.Series, Models",
              "Type": 1,
              "XAxis": 3,
              "YAxis": 0,
              "ColourArgb": -16736653,
              "FactorToVaryColours": null,
              "FactorToVaryMarkers": null,
              "FactorToVaryLines": null,
              "Marker": 11,
              "MarkerSize": 0,
              "Line": 0,
              "LineThickness": 0,
              "TableName": "Report21",
              "XFieldName": "Clock.Today",
              "YFieldName": "WheatYield",
              "X2FieldName": null,
              "Y2FieldName": null,
              "ShowInLegend": false,
              "IncludeSeriesNameInLegend": false,
              "Cumulative": false,
              "CumulativeX": false,
              "Filter": null,
              "Name": "Series",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            }
          ],
          "Enabled": true,
          "ReadOnly": false
        }
      ],
      "Enabled": true,
      "ReadOnly": false
    },
    {
      "$type": "Models.Storage.DataStore, Models",
      "CustomFileName": null,
      "Name": "DataStore",
      "ResourceName": null,
      "Children": [],
      "Enabled": true,
      "ReadOnly": false
    }
  ],
  "Enabled": true,
