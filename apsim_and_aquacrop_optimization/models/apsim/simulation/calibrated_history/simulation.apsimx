                    "[Leaf].BiomassRemovalDefaults.HarvestFractionLiveToRemove = 0.9",
                    "[Leaf].BiomassRemovalDefaults.HarvestFractionDeadToRemove = 0.9",
                    "[Leaf].BiomassRemovalDefaults.HarvestFractionLiveToResidue = 0",
                    "[Leaf].BiomassRemovalDefaults.HarvestFractionDeadToResidue = 0",
                    "[Stem].BiomassRemovalDefaults.HarvestFractionLiveToRemove = 0.9",
                    "[Stem].BiomassRemovalDefaults.HarvestFractionDeadToRemove = 0.9",
                    "[Stem].BiomassRemovalDefaults.HarvestFractionLiveToResidue = 0",
                    "[Stem].BiomassRemovalDefaults.HarvestFractionDeadToResidue = 0",
                    "[Inflorescence].BiomassRemovalDefaults.HarvestFractionLiveToRemove = 0.9",
                    "[Inflorescence].BiomassRemovalDefaults.HarvestFractionDeadToRemove = 0.9",
                    "[Inflorescence].BiomassRemovalDefaults.HarvestFractionLiveToResidue = 0",
                    "[Inflorescence].BiomassRemovalDefaults.HarvestFractionDeadToResidue = 0",
                    "[Leaf].Photosynthesis.RUE.FixedValue = 1.0292082694",
                    "[Phenology].Vegetative.Target.FixedValue = 100.207242661"
                  ],
                  "Name": "Vik9Proxy",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                }
              ],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.PMF.Plant, Models",
              "Name": "Mustard",
              "ResourceName": "Canola",
              "Children": [
                {
                  "$type": "Models.PMF.Cultivar, Models",
                  "Command": [
                    "[Phenology].Vegetative.Target.XYPairs.X = 0, 25",
                    "[Phenology].Vegetative.Target.XYPairs.Y = 210, 1",
                    "[Phenology].StemElongation.Target.PPResponse.Amount.FixedValue = 180",
                    "[Leaf].Phyllochron.Base.FixedValue = 55"
                  ],
                  "Name": "FlaxBiomassProxy",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.PMF.Cultivar, Models",
                  "Command": [
                    "[Phenology].Vegetative.Target.XYPairs.X = 0, 25",
                    "[Phenology].Vegetative.Target.XYPairs.Y = 210, 1",
                    "[Phenology].StemElongation.Target.PPResponse.Amount.FixedValue = 180",
                    "[Leaf].Phyllochron.Base.FixedValue = 55"
                  ],
                  "Name": "Mustard_sort",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                }
              ],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.PMF.Plant, Models",
              "Name": "Rape",
              "ResourceName": "Canola",
              "Children": [
                {
                  "$type": "Models.PMF.Cultivar, Models",
                  "Command": [
                    "[Phenology].Vegetative.Target.XYPairs.X = 0, 25",
                    "[Phenology].Vegetative.Target.XYPairs.Y = 290, 1",
                    "[Phenology].StemElongation.Target.PPResponse.Amount.FixedValue = 240",
                    "[Leaf].Phyllochron.Base.FixedValue = 65"
                  ],
                  "Name": "Rape_sort",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                }
              ],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Manager, Models",
              "CodeArray": [
                "using System;",
                "using System.Linq;",
                "using System.Globalization;",
                "using System.Collections.Generic;",
                "using APSIM.Core;",
                "using APSIM.Shared.Utilities;",
                "using Models.Core;",
                "using Models.PMF;",
                "using Models.PMF.Phen;",
                "using Models.PMF.Interfaces;",
                "",
                "namespace Models",
                "{",
                "    [Serializable]",
                "    public class Script : Model, IStructureDependency",
                "    {",
                "        public IStructure Structure { private get; set; }",
                "        [Link] private Clock Clock;",
                "        [Link] private Summary Summary;",
                "        [Link(ByName = true)] private Plant Wheat;",
                "        [Link(ByName = true)] private Plant Oats;",
                "        [Link(ByName = true)] private Plant Barley;",
                "        [Link(ByName = true)] private Plant RedClover;",
                "        [Link(ByName = true)] private Plant PlantainForage;",
                "        [Link(ByName = true)] private Plant Rape;",
                "        [Link(ByName = true)] private Plant Mustard;",
                "        [Description(\"Crop names per harvest year, '+' separates species, '-' means bare fallow\")]",
                "        public string[] RotationCrops { get; set; }",
                "        [Description(\"Cultivars per year; ';' separates mixture components\")]",
                "        public string[] RotationCultivars { get; set; }",
                "        [Description(\"Rotation setting retained by the APSIM editor\")]",
                "        public string[] RotationSowingDepths { get; set; }",
                "        [Description(\"Rotation setting retained by the APSIM editor\")]",
                "        public string[] RotationRowSpacings { get; set; }",
                "        [Description(\"Rotation setting retained by the APSIM editor\")]",
                "        public string[] RotationPopulations { get; set; }",
                "        [Description(\"Rotation setting retained by the APSIM editor\")]",
                "        public string[] RotationSowingDates { get; set; }",
                "        [Description(\"Rotation setting retained by the APSIM editor\")]",
                "        public string[] RotationHarvestDates { get; set; }",
                "        [Description(\"Rotation setting retained by the APSIM editor\")]",
                "        public string[] RotationHarvestCrops { get; set; }",
                "        [Description(\"grain, hay, green, unmanaged, fallow\")]",
                "        public string[] RotationUses { get; set; }",
                "        [Description(\"Rotation setting retained by the APSIM editor\")]",
                "        public string[] PastureAges { get; set; }",
                "        [Description(\"Rotation setting retained by the APSIM editor\")]",
                "        public string TerminationDate { get; set; } = \"20-Aug\";",
                "        [Description(\"Rotation setting retained by the APSIM editor\")]",
                "        public string WinterDiebackDate { get; set; } = \"01-Dec\";",
                "        public double HarvestDMKgHa { get; private set; }",
                "        public double HarvestDMTHa { get { return HarvestDMKgHa / 1000; } }",
                "        public double BiomassBeforeKgHa { get; private set; }",
                "        public double BiomassAfterKgHa { get; private set; }",
                "        public string HarvestCrop { get; private set; }",
                "        public string HarvestUse { get; private set; }",
                "        public int HarvestYear { get; private set; }",
                "        public event EventHandler HarvestRecorded;",
                "        private Dictionary<string, Plant> plants;",
                "        private DateTime? undersowDate;",
                "        private int firstYear;",
                "        private Phenology Pheno(Plant p) { return Structure.FindChild<Phenology>(relativeTo:p); }",
                "        private double Stage(Plant p) { return p.IsAlive ? Pheno(p).Stage : 0; }",
                "        private double Zadok(Plant p) { return p.IsAlive ? Pheno(p).Zadok : 0; }",
                "        public double WheatStage { get { return Stage(Wheat); } }",
                "        public double WheatZadok { get { return Zadok(Wheat); } }",
                "        public double OatsStage { get { return Stage(Oats); } }",
                "        public double OatsZadok { get { return Zadok(Oats); } }",
                "        public double BarleyStage { get { return Stage(Barley); } }",
                "        public double BarleyZadok { get { return Zadok(Barley); } }",
                "        public double RedCloverStage { get { return Stage(RedClover); } }",
                "        public double PlantainForageStage { get { return Stage(PlantainForage); } }",
                "        public double MustardStage { get { return Stage(Mustard); } }",
                "        public double RapeStage { get { return Stage(Rape); } }",
                "",
                "        [EventSubscribe(\"StartOfSimulation\")]",
                "        private void Start(object sender, EventArgs e)",
                "        {",
                "            firstYear = Clock.StartDate.Year;",
                "            plants = new Dictionary<string, Plant> { {\"Wheat\",Wheat}, {\"Oats\",Oats}, {\"Barley\",Barley},",
                "                {\"RedClover\",RedClover}, {\"PlantainForage\",PlantainForage}, {\"Rape\",Rape}, {\"Mustard\",Mustard} };",
                "            if (new [] {RotationCrops,RotationCultivars,RotationSowingDepths,RotationRowSpacings,",
                "                RotationPopulations,RotationSowingDates,RotationHarvestDates,RotationHarvestCrops,",
                "                RotationUses,PastureAges}.Any(a=>a==null))",
                "                throw new Exception(\"Missing rotation settings. Restore all rotation arrays before running.\");",
                "            int n=RotationCrops.Length;",
                "            if (new [] {RotationCultivars.Length,RotationSowingDepths.Length,RotationRowSpacings.Length,",
                "                RotationPopulations.Length,RotationSowingDates.Length,RotationHarvestDates.Length,",
                "                RotationHarvestCrops.Length,RotationUses.Length,PastureAges.Length}.Any(v=>v!=n))",
                "                throw new Exception(\"History rotation arrays have unequal lengths\");",
                "            for(int i=0;i<n;i++)",
                "            {",
                "                int count=Parts(RotationCrops[i],'+').Length;",
                "                foreach(string spec in new [] {RotationCultivars[i],RotationSowingDepths[i],RotationRowSpacings[i],RotationPopulations[i]})",
                "                    if(Parts(spec,';').Length!=count) throw new Exception(\"History mixture lengths differ, year \"+(firstYear+i));",
                "            }",
                "            if (Persistent(0) || Winter(0))",
                "            {",
                "                Sow(0,false,false);",
                "                Summary.WriteMessage(this,\"INITIAL STATE APPROXIMATION: existing sward/winter cereal is sown on simulation start; mature roots and pre-start reserves are unavailable.\",MessageType.Warning);",
                "            }",
                "        }",
                "",
                "        [EventSubscribe(\"DoManagement\")]",
                "        private void Manage(object sender, EventArgs e)",
                "        {",
                "            int i=Clock.Today.Year-firstYear;",
                "            if(i<0 || i>=RotationCrops.Length) return;",
                "            if(undersowDate.HasValue && Clock.Today==undersowDate.Value)",
                "            { Sow(i,true,true); undersowDate=null; }",
                "",
                "            // Regrowth phenology is a documented approximation, not a winter survival model.",
                "            if(Persistent(i) && Match(\"01-Mar\"))",
                "                foreach(Plant p in plants.Values.Where(p=>Perennial(p.Name) && p.IsAlive))",
                "                    if(Pheno(p).Stage>3) Pheno(p).SetToStage(3);",
                "",
                "            if(RotationUses[i]==\"fallow\" && Match(\"01-May\")) EndAll();",
                "            if(Persistent(i) && Match(RotationSowingDates[i]))",
                "            {",
                "                var names=Parts(RotationCrops[i],'+');",
                "                var cvs=Parts(RotationCultivars[i],';');",
                "                bool compatible=names.Select((name,c)=>plants[name].IsAlive && plants[name].SowingData.Cultivar==cvs[c]).All(v=>v)",
                "                    && plants.Values.Where(p=>p.IsAlive).All(p=>names.Contains(p.Name));",
                "                // An age reset without an undersown predecessor represents a new establishment.",
                "                if(i>0 && PastureAges[i]==\"1\" && Persistent(i-1) && PastureAges[i-1]!=\"0\") compatible=false;",
                "                if(!compatible)",
                "                {",
                "                    EndAll(); Sow(i,false,false);",
                "                    Summary.WriteMessage(this,\"ASSUMED ESTABLISHMENT: pasture missing or composition changed; sown on \"+Clock.Today.ToString(\"yyyy-MM-dd\"),MessageType.Warning);",
                "                }",
                "            }",
                "            if(!Persistent(i) && RotationUses[i]!=\"fallow\" && !Winter(i) && Match(RotationSowingDates[i]))",
                "            {",
                "                EndAll(); Sow(i,false,true);",
                "                if(Parts(RotationCrops[i],'+').Any(Perennial)) undersowDate=Clock.Today.AddDays(1);",
                "            }",
                "            if(Match(RotationHarvestDates[i])) Harvest(i);",
                "            int next=i+1;",
                "            if(Persistent(i) && next<RotationCrops.Length && !Persistent(next) && Match(TerminationDate)) EndAll();",
                "            if(next<RotationCrops.Length && Winter(next) && Match(RotationSowingDates[next]))",
                "            { EndAll(); Sow(next,false,false); }",
                "            if(RotationUses[i]==\"hay\" && next<RotationCrops.Length && Persistent(next) && Match(WinterDiebackDate))",
                "                foreach(Plant p in plants.Values.Where(p=>Perennial(p.Name) && p.IsAlive))",
                "                    foreach(var organ in Aboveground(p)) organ.RemoveBiomass(0,0,1,1);",
                "        }",
                "",
                "        private static string[] Parts(string value,char sep)",
                "        { return value==\"-\" ? new string[0] : value.Split(sep).Select(s=>s.Trim()).ToArray(); }",
                "        private bool Match(string date) { return date!=\"-\" && DateUtilities.WithinDates(date,Clock.Today,date); }",
                "        private bool Persistent(int i) { return RotationUses[i]==\"hay\" || RotationUses[i]==\"unmanaged\"; }",
                "        private bool Winter(int i) { return RotationCultivars[i].Contains(\"Winter_rye\"); }",
                "        private static bool Perennial(string name) { return name==\"RedClover\" || name==\"PlantainForage\"; }",
                "        private IEnumerable<IHasDamageableBiomass> Aboveground(Plant p)",
                "        { return Structure.FindChildren<IHasDamageableBiomass>(relativeTo:p).Where(o=>new [] {\"Leaf\",\"Petiole\",\"Stem\",\"Inflorescence\",\"Panicle\",\"Grain\"}.Contains(((IModel)o).Name)); }",
                "        private void Sow(int i,bool perennialsOnly,bool split)",
                "        {",
                "            var names=Parts(RotationCrops[i],'+'); var cvs=Parts(RotationCultivars[i],';');",
                "            var depths=Parts(RotationSowingDepths[i],';'); var rows=Parts(RotationRowSpacings[i],';'); var pops=Parts(RotationPopulations[i],';');",
                "            for(int c=0;c<names.Length;c++)",
                "            {",
                "                if(split && Perennial(names[c])!=perennialsOnly) continue;",
                "                Plant p=plants[names[c]];",
                "                if(p.IsAlive) throw new Exception(\"Attempt to resow living crop \"+p.Name);",
                "                p.Sow(cultivar:cvs[c],population:double.Parse(pops[c],CultureInfo.InvariantCulture),",
                "                    depth:double.Parse(depths[c],CultureInfo.InvariantCulture),rowSpacing:double.Parse(rows[c],CultureInfo.InvariantCulture));",
                "                Summary.WriteMessage(this,\"SOW \"+p.Name+\" \"+cvs[c]+\" \"+Clock.Today.ToString(\"yyyy-MM-dd\"),MessageType.Information);",
                "            }",
                "        }",
                "        private void Harvest(int i)",
                "        {",
                "            HarvestDMKgHa=BiomassBeforeKgHa=BiomassAfterKgHa=0;",
                "            HarvestYear=Clock.Today.Year; HarvestCrop=RotationHarvestCrops[i]; HarvestUse=RotationUses[i];",
                "            if(HarvestUse!=\"fallow\" && HarvestUse!=\"unmanaged\")",
                "                foreach(string name in Parts(HarvestCrop,'+'))",
                "                {",
                "                    Plant p=plants[name];",
                "                    if(!p.IsAlive) throw new Exception(\"Scheduled harvest of absent crop \"+name+\" \"+HarvestYear);",
                "                    double before=p.AboveGround.Wt*10; BiomassBeforeKgHa+=before;",
                "                    if(HarvestUse==\"grain\") HarvestDMKgHa+=Convert.ToDouble(Structure.Get(\"Grain.Total.Wt\",relativeTo:p))*10;",
                "                    p.Harvest();",
                "                    double after=p.AboveGround.Wt*10; BiomassAfterKgHa+=after;",
                "                    if(HarvestUse!=\"grain\") HarvestDMKgHa+=Math.Max(0,before-after);",
                "                    if(!Perennial(name) || HarvestUse==\"green\") p.EndCrop();",
                "                }",
                "            Summary.WriteMessage(this,\"ANNUAL RECORD \"+HarvestCrop+\" \"+Clock.Today.ToString(\"yyyy-MM-dd\")+\" DM kg/ha=\"+HarvestDMKgHa.ToString(\"F2\",CultureInfo.InvariantCulture),MessageType.Information);",
                "            HarvestRecorded?.Invoke(this,EventArgs.Empty);",
                "        }",
                "        private void EndAll() { foreach(Plant p in plants.Values.Where(p=>p.IsAlive)) p.EndCrop(); }",
                "    }",
                "}"
              ],
              "Parameters": [
                {
                  "Key": "RotationCrops",
                  "Value": "Oats, Wheat, Barley+RedClover+PlantainForage, RedClover+PlantainForage, RedClover+PlantainForage, RedClover+PlantainForage, Barley, Wheat, Mustard, Oats+RedClover+PlantainForage, RedClover+PlantainForage, RedClover+PlantainForage, RedClover+PlantainForage, Wheat, Mustard, Wheat, Oats+RedClover+PlantainForage, RedClover+PlantainForage, RedClover+PlantainForage, Wheat"
                },
                {
                  "Key": "RotationCultivars",
                  "Value": "Sang, Lada, Barley_sort;Vik7;Vik9Proxy, Vik7;Vik9Proxy, Vik7;Vik9Proxy, Vik7;Vik9Proxy, Barley_sort, Irgina, FlaxBiomassProxy, Argamak;Vik7;Vik9Proxy, Vik7;Vik9Proxy, Vik7;Vik9Proxy, Vik7;Vik9Proxy, Irgina, Mustard_sort, Winter_rye_smoke, Yakov;Vik7;Vik9Proxy, Vik7;Vik9Proxy, Vik7;Vik9Proxy, Winter_rye_smoke"
                },
                {
                  "Key": "RotationSowingDepths",
                  "Value": "20, 30, 20;10;10, 10;10, 10;10, 10;10, 20, 30, 20, 20;10;10, 10;10, 10;10, 10;10, 30, 20, 30, 20;10;10, 10;10, 10;10, 30"
                },
                {
                  "Key": "RotationRowSpacings",
                  "Value": "150, 200, 200;150;150, 150;150, 150;150, 150;150, 200, 200, 200, 150;150;150, 150;150, 150;150, 150;150, 200, 200, 200, 150;150;150, 150;150, 150;150, 200"
                },
                {
                  "Key": "RotationPopulations",
                  "Value": "250, 382.99999999999994, 450;150;150, 150;150, 150;150, 150;150, 450, 516.0, 45, 250;150;150, 150;150, 150;150, 150;150, 453.75, 45, 230, 250;150;150, 150;150, 150;150, 230"
                },
                {
                  "Key": "RotationSowingDates",
                  "Value": "18-May, 18-May, 10-May, 15-May, 15-May, 15-May, 10-May, 12-May, 10-May, 18-May, 15-May, 15-May, 15-May, 15-May, 10-May, 04-Sep, 28-Apr, 15-May, 15-May, 05-Sep"
                },
                {
                  "Key": "RotationHarvestDates",
                  "Value": "31-Aug, 25-Aug, 31-Aug, 15-Jul, 15-Jul, 15-Jul, 31-Aug, 10-Aug, 15-Jul, 31-Aug, 15-Jul, 15-Jul, 15-Jul, 12-Aug, 31-Aug, 31-Aug, 31-Aug, 15-Jul, 15-Jul, 31-Aug"
                },
                {
                  "Key": "RotationHarvestCrops",
                  "Value": "Oats, Wheat, Barley, RedClover+PlantainForage, RedClover+PlantainForage, RedClover+PlantainForage, Barley, Wheat, Mustard, Oats, RedClover+PlantainForage, RedClover+PlantainForage, RedClover+PlantainForage, Wheat, Mustard, Wheat, Oats, RedClover+PlantainForage, RedClover+PlantainForage, Wheat"
                },
                {
                  "Key": "RotationUses",
                  "Value": "grain, grain, grain, hay, hay, hay, grain, grain, green, grain, hay, hay, hay, grain, grain, grain, grain, hay, hay, grain"
                },
                {
                  "Key": "PastureAges",
                  "Value": "0, 0, 0, 1, 2, 3, 0, 0, 0, 0, 1, 2, 3, 0, 0, 0, 0, 1, 2, 0"
                },
                {
                  "Key": "TerminationDate",
                  "Value": "20-Aug"
                },
                {
                  "Key": "WinterDiebackDate",
                  "Value": "01-Dec"
                }
              ],
              "Name": "RotationManager",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Manager, Models",
              "CodeArray": [
                "using System;",
                "using System.Collections.Generic;",
                "using Models.Core;",
                "using Models.PMF;",
                "using Models.Soils.Nutrients;",
                "",
                "namespace Models",
                "{",
                "    [Serializable]",
                "    public class Script : Model",
                "    {",
                "        [Link] private Clock Clock;",
                "        [Link] private Fertiliser Fertiliser;",
                "        [Link] private Summary Summary;",
                "",
                "        [Description(\"Fertiliser type for each year of rotation (same order as rotation years)\")]",
                "        public string[] FertiliserTypes { get; set; }",
                "",
                "        [Description(\"Amount of fertiliser for each year of rotation (kg/ha), same order\")]",
                "        public double[] FertiliserAmounts { get; set; }",
                "",
                "        [Description(\"Apply fertiliser only at sowing of these crops (leave empty = all sowings)\")]",
                "        public string[] ApplyAtCrops { get; set; }",
                "",
                "        private int startYear;",
                "        private HashSet<string> fertilisedToday = new HashSet<string>();",
                "",
                "        [EventSubscribe(\"StartOfSimulation\")]",
                "        private void OnStart(object sender, EventArgs e)",
                "        {",
                "            startYear = Clock.StartDate.Year;",
                "        }",
                "",
                "        [EventSubscribe(\"Sowing\")]",
                "        private void OnSowing(object sender, EventArgs e)",
                "        {",
                "            int yearIndex = Clock.Today.Year - Clock.StartDate.Year;",
                "            Plant crop = sender as Plant;",
                "            // Arrays refer to the harvest year. Autumn-sown rye belongs to next year.",
                "            if (crop != null && crop.SowingData.Cultivar != null &&",
                "                crop.SowingData.Cultivar.Contains(\"Winter_rye\") && Clock.Today.Month >= 7)",
                "                yearIndex++;",
                "            if (yearIndex < 0 || yearIndex >= FertiliserAmounts.Length)",
                "                return;",
                "",
                "            // If ApplyAtCrops specified, only fertilise at sowing of those crops",
                "            if (ApplyAtCrops != null && ApplyAtCrops.Length > 0)",
                "            {",
                "                string sownCrop = (sender as Plant)?.Name ?? \"\";",
                "                bool match = false;",
                "                foreach (string c in ApplyAtCrops)",
                "                    if (string.Equals(c, sownCrop, StringComparison.OrdinalIgnoreCase))",
                "                    { match = true; break; }",
                "                if (!match)",
                "                    return;",
                "            }",
                "",
                "            // Prevent double application on the same day (e.g. when sowing a mixture)",
                "            string key = Clock.Today.ToString(\"yyyy-MM-dd\");",
                "            if (fertilisedToday.Contains(key))",
                "                return;",
                "",
                "            double amount = FertiliserAmounts[yearIndex];",
                "            if (amount <= 0)",
                "                return;",
                "",
                "            string type = FertiliserTypes != null && yearIndex < FertiliserTypes.Length",
                "                ? FertiliserTypes[yearIndex]",
                "                : \"Urea\";",
                "",
                "            Fertiliser.Apply(amount: amount, type: type);",
                "            fertilisedToday.Add(key);",
                "            Summary.WriteMessage(this, $\"Applied {amount} kg/ha of {type} on {Clock.Today:d}\", MessageType.Information);",
                "        }",
                "    }",
                "}"
              ],
              "Parameters": [
                {
                  "Key": "FertiliserTypes",
                  "Value": "NO3N, NO3N, NO3N, NO3N, NO3N, NO3N, NO3N, NO3N, NO3N, NO3N, NO3N, NO3N, NO3N, NO3N, NO3N, NO3N, NO3N, NO3N, NO3N, NO3N"
                },
                {
                  "Key": "FertiliserAmounts",
                  "Value": "30.0, 30.0, 30, 0, 0, 0, 30, 30.0, 30, 30.0, 0, 0, 0, 30.0, 30, 30.0, 30.0, 0, 0, 30.0"
                },
                {
                  "Key": "ApplyAtCrops",
                  "Value": "Wheat, Oats, Barley, Mustard, Rape"
                }
              ],
              "Name": "Fertilise at sowing",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Manager, Models",
              "CodeArray": [
                "using APSIM.Shared.Utilities;",
                "using Models.Utilities;",
                "using Models.Soils;",
                "using Models.PMF;",
                "using Models.Core;",
                "using System;",
                "using System.Linq;",
                "",
                "namespace Models",
                "{",
                "    [Serializable] ",
                "    public class Script : Model",
                "    {",
                "        [Description(\"Crop\")]",
                "        public IPlant Crop { get; set; }",
                "        ",
                "        [EventSubscribe(\"DoManagement\")]",
                "        private void OnDoManagement(object sender, EventArgs e)",
                "        {",
                "            if (Crop.IsReadyForHarvesting)",
                "            {",
                "                Crop.Harvest();",
                "                Crop.EndCrop();",
                "            }",
                "        }",
                "    }",
                "}",
                "       "
              ],
              "Parameters": [
                {
                  "Key": "Crop",
                  "Value": "[Wheat]"
                }
              ],
              "Name": "Harvest",
              "ResourceName": null,
              "Children": [],
              "Enabled": false,
              "ReadOnly": false
            },
            {
              "$type": "Models.Manager, Models",
              "CodeArray": [
                "using Models.Climate;",
                "using APSIM.Shared.Utilities;",
                "using Models.Soils.Nutrients;",
                "using Models.Soils;",
                "using Models.PMF;",
                "using Models.Core;",
                "using System.Xml.Serialization;",
                "using System;",
                "using System.Linq;",
                "using Models.AgPasture;",
                "using Models.Interfaces;",
                "",
                "namespace Models",
                "{",
                "    [Serializable] ",
                "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                "    public class Script : Model",
                "    {",
                "        [Link] Clock clock;",
                "        [Link] ISummary summary;",
                "        [Link] private Swim3 swim;",
                "        //[Link] private PastureSpecies ryegrass;",
                "        //[Link] private SimpleGrazing grazing;",
                "        ",
                "        public enum LowerBCTypeOptions {gradient,seepage,potential};",
                "",
                "        [Separator(\"Sets the lower boundary condition type (and value if set to 'potential' for SWIM3. The change is applied at the beginning of the first day of the simulation.\")]",
                "        [Description(\"[Get a dropdown] What lower boundary condition is wanted?\")] public LowerBCTypeOptions LowerBCType { get; set; }",
                "        [Description(\"If 'potential', then what potential? (mm) \")] public double LowerBCValue { get; set; }",
                "",
                "        public double SoilWaterStart  { get; set; }",
                "        public double SoilWaterEnd  { get; set; }",
                "",
                "        [EventSubscribe(\"DoDailyInitialisation\")]",
                "        private void DoDailyInitialisation(object sender, EventArgs e)",
                "        {",
                "        }",
                "",
                "        [EventSubscribe(\"DoReportCalculations\")]",
                "        private void DoReportCalculations(object sender, EventArgs e)",
                "        {",
                "        }",
                "",
                "        [EventSubscribe(\"DoManagement\")]",
                "        private void DoDailyCalculations(object sender, EventArgs e)",
                "        {",
                "            if (clock.Today == clock.StartDate)",
                "            {",
                "                summary.WriteMessage(this, \"Script is setting lower boundary condition to \" + LowerBCType, MessageType.Diagnostic);",
                "                if (LowerBCType == LowerBCTypeOptions.gradient)",
                "                    swim.SetLowerBCForGradient(bbcGradient: 0.0);   // in cm/cm (ibbc=0) Note that this is the default setting",
                "                else if (LowerBCType == LowerBCTypeOptions.potential)",
                "                    swim.SetLowerBCForGivenPotential(bbcPotential: LowerBCValue /10.0 );    //  convert to cm (ibbc=1), DUL is -100 cm so values more positive will often result in inflow to the bottom of the soil profile. Input in mm so divide here.",
                "                else if (LowerBCType == LowerBCTypeOptions.seepage)",
                "                    swim.SetLowerBCForSeepage(bbcPotentialSeepage: 0.0);  // in cm (ibbc=3). This is for zero-tension lysimeters",
                "                else",
                "                    throw new Exception(\"Wrong lower boundary condition type\");",
                "            }",
                "        }",
                "    }",
                "}"
              ],
              "Parameters": [
                {
                  "Key": "LowerBCType",
                  "Value": "seepage"
                },
                {
                  "Key": "LowerBCValue",
                  "Value": "-500"
                }
              ],
              "Name": "SWIMSetLowerBC",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
