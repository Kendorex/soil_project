                  "Value": "31-Aug, 31-Aug, 31-Aug, 31-Aug, 31-Aug, 31-Aug, 31-Aug, 31-Aug, 31-Aug, 31-Aug, 31-Aug, 31-Aug, 31-Aug, 15-Jul, 15-Jul, 15-Jul, 31-Aug, 16-Aug, 31-Aug, 15-Jul"
                },
                {
                  "Key": "RotationHarvestCrops",
                  "Value": "-, -, -, -, -, -, -, -, -, Wheat, Rape, Wheat, Oats, RedClover+PlantainForage, RedClover+PlantainForage, RedClover+PlantainForage, Mustard, Wheat, Oats, RedClover+PlantainForage"
                },
                {
